-- ✅ LÓGICA DE BOTONES "BOLITA" (V1, V2, AUTOJOIN)
local function createToggle(parent, text, pos, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 100, 0, 30); btn.Position = pos; btn.BackgroundColor3 = Color3.fromRGB(60,20,20); btn.Text = text; btn.TextColor3 = Color3.new(1,1,1); btn.Font = "GothamBold"; Instance.new("UICorner", btn)
    
    local ball = Instance.new("Frame", btn)
    ball.Size = UDim2.new(0, 18, 0, 18); ball.Position = UDim2.new(0, 5, 0.5, -9); ball.BackgroundColor3 = Color3.new(1,1,1); Instance.new("UICorner", ball)

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        ball:TweenPosition(state and UDim2.new(1, -23, 0.5, -9) or UDim2.new(0, 5, 0.5, -9), "Out", "Quad", 0.2, true)
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(60,20,20)
        callback(state)
    end)
end

