local function savePositions()
    local data = {
        main = {
            X = {Scale = main.Position.X.Scale, Offset = main.Position.X.Offset},
            Y = {Scale = main.Position.Y.Scale, Offset = main.Position.Y.Offset}
        }
    }

    if frame then
        data.mini = {
            X = {Scale = frame.Position.X.Scale, Offset = frame.Position.X.Offset},
            Y = {Scale = frame.Position.Y.Scale, Offset = frame.Position.Y.Offset}
        }
    end

    writefile("atlas_gui.json", HttpService:JSONEncode(data))
end

