-- ==========================================
-- TOGGLES LOGIC
-- ==========================================
local toggles = {v1 = false, v2 = false, a = false}
local miniLabels = {}

local function updateMini()
    if miniLabels.v1 then
        miniLabels.v1.Text = "V1: " .. (toggles.v1 and "ON" or "OFF")
        miniLabels.v1.TextColor3 = toggles.v1 and Color3.fromRGB(80,170,255) or Color3.fromRGB(255,80,80)
    end
    if miniLabels.v2 then
        miniLabels.v2.Text = "V2: " .. (toggles.v2 and "ON" or "OFF")
        miniLabels.v2.TextColor3 = toggles.v2 and Color3.fromRGB(80,170,255) or Color3.fromRGB(255,80,80)
    end
    if miniLabels.a then
        miniLabels.a.Text = "Autojoin: " .. (toggles.a and "ON" or "OFF")
        miniLabels.a.TextColor3 = toggles.a and Color3.fromRGB(80,170,255) or Color3.fromRGB(255,80,80)
    end
end

local function toggle(btn, id)
    toggles[id] = not toggles[id]
    btn.BackgroundColor3 = toggles[id] and Color3.fromRGB(20,40,80) or Color3.fromRGB(50,20,20)
    btn.TextColor3 = toggles[id] and Color3.fromRGB(80,170,255) or Color3.fromRGB(255,80,80)
    updateMini()
end

local function makeBtn(text, x, id)
    local b = Instance.new("TextButton", autoPage)
    b.Size = UDim2.new(0, 70, 0, 20)
    b.Position = UDim2.new(0, x, 0, 0)
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.BackgroundColor3 = Color3.fromRGB(50,20,20)
    b.TextColor3 = Color3.fromRGB(255,80,80)
    Instance.new("UICorner", b)
    if id then b.MouseButton1Click:Connect(function() toggle(b, id) end) end
    return b
end

