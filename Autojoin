local function saveData()
    local data = {toggles = {v1 = toggles.v1, v2 = toggles.v2, ca = toggles.ca, lock = toggles.lock}, filters = filters, primeFilters = primeFilters, prio = priorityList, mainPos = {main.Position.X.Offset, main.Position.Y.Offset}, miniPos = {frame.Position.X.Offset, frame.Position.Y.Offset}, config = config}
    writefile(FILE_CONFIG, HttpService:JSONEncode(data)); writefile(FILE_USADOS, HttpService:JSONEncode(usados))
end

local function loadData()
    if isfile(FILE_CONFIG) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_CONFIG)) end)
        if ok then
            toggles.v1 = data.toggles.v1; toggles.v2 = data.toggles.v2; toggles.ca = data.toggles.ca; toggles.lock = data.toggles.lock or false
            filters = data.filters or filters; primeFilters = data.primeFilters or primeFilters; priorityList = data.prio or priorityList
            
            -- Fusión automática: Si hay algo nuevo en ALL_OBJECTS, meterlo a filtros sin resetear
            for _, name in ipairs(ALL_OBJECTS) do
                if not filters[name] then filters[name] = {enabled = false, minVal = 0} end
                if not primeFilters[name] then primeFilters[name] = {enabled = false, minVal = 0} end
                if not table.find(priorityList, name) then table.insert(priorityList, name) end
            end

            if data.config then config = data.config end
            if data.mainPos then main.Position = UDim2.new(0.5, data.mainPos[1], 0.5, data.mainPos[2]) end
            if data.miniPos then frame.Position = UDim2.new(1, data.miniPos[1], 0, data.miniPos[2]); miniShadow.Position = frame.Position end
        end
    end
    if isfile(FILE_USADOS) then pcall(function() usados = HttpService:JSONDecode(readfile(FILE_USADOS)) end) end
    task.spawn(function()
        if isfile(FILE_LAST_JOIN) then
            local last = readfile(FILE_LAST_JOIN)
            repeat task.wait() until player.Character
            task.wait(1)
            showNotify("LAST JOIN: " .. last)
        end
    end)
end

-- ARRASTRE CON LOCK
local function makeDraggable(obj, target, isMini)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    obj.InputBegan:Connect(function(input)
        if toggles.lock then return end
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = target.Position; moved = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and not toggles.lock and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then moved = true end
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            if isMini then miniShadow.Position = target.Position end
        end
    end)
    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false; saveData()
            if not moved and isMini then main.Visible = true; miniGui.Enabled = false end
        end
    end)
end
