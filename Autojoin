-- ==========================================
-- FUNCIONES DE PERSISTENCIA
-- ==========================================
local function savePositions()
    -- Solo guardamos si las variables principales existen
    if main and frame then
        local data = {
            main = {
                X = main.Position.X.Offset,
                Y = main.Position.Y.Offset
            },
            mini = {
                X = frame.Position.X.Offset,
                Y = frame.Position.Y.Offset
            }
        }
        pcall(function()
            writefile("atlas_gui.json", HttpService:JSONEncode(data))
        end)
    end
end

