-- ✅ MOTOR DE ESCANEO (V17)
local function escanear()
    if joinLock or not autojoin_Enabled then return end
    local pm = player.PlayerGui:FindFirstChild("PetMenu")
    if not pm then return end
    
    local allFrames = {}; for _,v in ipairs(pm.Frame.ScrollingFrame:GetChildren()) do if v:IsA("Frame") and v.Visible then table.insert(allFrames, v) end end
    
    -- Limpieza automática
    if autoCleanEnabled then
        local firmasActuales = {}; for i=1, 5 do if allFrames[i] then local lbl = allFrames[i]:FindFirstChild("TextLabel"); if lbl then firmasActuales[lbl.Text] = true end end end
        for firma, _ in pairs(usados) do
            if not firmasActuales[firma] then
                ausenciaContador[firma] = (ausenciaContador[firma] or 0) + 1
                if ausenciaContador[firma] >= 6 then usados[firma] = nil; ausenciaContador[firma] = nil end
            end
        end
    end

    for _, name in ipairs(priorityList) do
        for i=1, 5 do
            local frameObj = allFrames[i]
            if frameObj then
                local lbl = frameObj:FindFirstChild("TextLabel")
                if lbl and lbl.Text:lower():find(name:lower()) and not usados[lbl.Text] then
                    joinLock = true; usados[lbl.Text] = true; saveFilters()
                    local btn = frameObj:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
                    for _=1, 50 do for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end end
                    task.delay(2, function() joinLock = false end)
                    return
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        if autojoin_Enabled then
            if v1_Enabled and getgenv().mousemoveabs then
                getgenv().mousemoveabs(543, 154); getgenv().mouse1click()
            end
            escanear()
        end
    end
end)

