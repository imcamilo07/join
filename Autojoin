local function parseSms(txt, targetName)
    local lowTxt = txt:lower(); local startIdx = lowTxt:find(targetName:lower(), 1, true)
    if startIdx then
        local sub = txt:sub(startIdx + #targetName); local n, suf = sub:match("(%d+%.?%d*)([MB])")
        local val = tonumber(n) or 0
        if suf == "B" then val = val * 1000 end; return val
    end
    return 0
end

local function escanear()
    if joinLock or not toggles.a then return end
    local pm = player.PlayerGui:FindFirstChild("jackk"); if not pm then return end
    local sc = pm.Frame:FindFirstChild("ScrollingFrame")
    local allFrames = {}; for _,v in ipairs(sc:GetChildren()) do if v:IsA("Frame") and v.Visible then table.insert(allFrames, v) end end
    
    local limiteEscaneo = math.min(#allFrames, 5)
    local firmasActuales = {}; for i = 1, limiteEscaneo do local lbl = allFrames[i]:FindFirstChild("TextLabel"); if lbl then firmasActuales[lbl.Text] = true end end
    
    local umbralLimpieza = toggles.v1 and 6 or 20 
    for firma, _ in pairs(usados) do
        if not firmasActuales[firma] then
            ausenciaContador[firma] = (ausenciaContador[firma] or 0) + 1
            if ausenciaContador[firma] >= umbralLimpieza then usados[firma] = nil; ausenciaContador[firma] = nil end
        else ausenciaContador[firma] = 0 end
    end

    local candidatos, currentData = {}, toggles.ca and primeFilters or filters
    for i = 1, limiteEscaneo do
        local lbl = allFrames[i]:FindFirstChild("TextLabel")
        if lbl and not usados[lbl.Text] then
            for name, data in pairs(currentData) do
                if data.enabled and lbl.Text:lower():find(name:lower(), 1, true) then
                    local val = parseSms(lbl.Text, name)
                    if val >= data.minVal then table.insert(candidatos, {frame = allFrames[i], name = name, val = val, firma = lbl.Text}) end
                end
            end
        end
    end
    if #candidatos > 0 then
        table.sort(candidatos, function(a,b) return (table.find(priorityList, a.name) or 999) < (table.find(priorityList, b.name) or 999) end)
        local mejor = candidatos[1]; joinLock = true; usados[mejor.firma] = true; saveData()
        local s = Instance.new("Sound", game.SoundService); s.SoundId = "rbxassetid://128387076668435"; s.Volume = 1; s:Play()
        writefile(FILE_LAST_JOIN, mejor.name.." $"..mejor.val.."M/s"); local btn = mejor.frame:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
        for i = 1, 200 do for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end end
        task.delay(1.5, function() joinLock = false end)
    end
end

task.spawn(function()
    while true do
        if toggles.a and not joinLock then
            local pm = player.PlayerGui:FindFirstChild("jackk")
            if pm then
                if getgenv().mousemoveabs then getgenv().mousemoveabs(543, 154); getgenv().mouse1click() end
                if toggles.v1 then task.wait(0.2) elseif toggles.v2 then local s = tick(); while not pm.Frame.ScrollingFrame:FindFirstChildWhichIsA("Frame") and (tick()-s)<0.25 do task.wait() end; task.wait(0.03) else task.wait(0.5) end
                escanear()
            end
        end
        task.wait(0.01)
    end
end)

