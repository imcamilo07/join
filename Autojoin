local renderPrio -- Definición previa

local function updateFilters()
    scrollSel:ClearAllChildren()
    for i, name in ipairs(ALL_OBJECTS) do
        local b = Instance.new("TextButton", scrollSel)
        b.Size = UDim2.new(0.9, 0, 0, 30); b.Position = UDim2.new(0.05, 0, 0, (i-1)*33); b.Text = name; b.TextSize = 10; b.BackgroundColor3 = selectedData[name].enabled and Color3.fromRGB(0,100,200) or Color3.fromRGB(30,30,45); b.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", b)
        b.MouseButton1Click:Connect(function()
            selectedData[name].enabled = not selectedData[name].enabled
            if selectedData[name].enabled then table.insert(priorityList, name) else
                for k,v in ipairs(priorityList) do if v == name then table.remove(priorityList, k) break end end
            end
            b.BackgroundColor3 = selectedData[name].enabled and Color3.fromRGB(0,100,200) or Color3.fromRGB(30,30,45)
            renderPrio(); saveFilters()
        end)
    end
end

function renderPrio()
    scrollPrio:ClearAllChildren()
    for i, name in ipairs(priorityList) do
        local f = Instance.new("Frame", scrollPrio)
        f.Size = UDim2.new(0.95, 0, 0, 30); f.Position = UDim2.new(0, 0, 0, (i-1)*33); f.BackgroundColor3 = Color3.fromRGB(20,20,35); Instance.new("UICorner", f)
        local t = Instance.new("TextLabel", f); t.Size = UDim2.new(0.7,0,1,0); t.Text = name; t.TextSize = 10; t.TextColor3 = Color3.new(1,1,1); t.BackgroundTransparency = 1
        
        local up = Instance.new("TextButton", f); up.Size = UDim2.new(0.12,0,0.5,0); up.Position = UDim2.new(0.75,0,0,0); up.Text = "▲"; up.TextColor3 = Color3.new(1,1,1); up.BackgroundTransparency = 1
        local dw = Instance.new("TextButton", f); dw.Size = UDim2.new(0.12,0,0.5,0); dw.Position = UDim2.new(0.75,0,0.5,0); dw.Text = "▼"; dw.TextColor3 = Color3.new(1,1,1); dw.BackgroundTransparency = 1
        
        up.MouseButton1Click:Connect(function() if i > 1 then table.remove(priorityList, i); table.insert(priorityList, i-1, name); renderPrio(); saveFilters() end end)
        dw.MouseButton1Click:Connect(function() if i < #priorityList then table.remove(priorityList, i); table.insert(priorityList, i+1, name); renderPrio(); saveFilters() end end)
    end
    scrollPrio.CanvasSize = UDim2.new(0,0,0,#priorityList*33)
end
updateFilters(); renderPrio()

