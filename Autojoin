-- LÓGICA DEL MOTOR (SCRIPT V17)
local function parseSms(txt, targetName)
    local lowTxt, lowTarget = txt:lower(), targetName:lower()
    local startIdx = lowTxt:find(lowTarget, 1, true)
    if startIdx then
        local sub = txt:sub(startIdx + #targetName); local n = sub:match("(%d+%.?%d*)"); local val = tonumber(n) or 0
        if sub:find("B") and sub:find("B") < 15 then val = val * 1000 end; return val
    end; return 0
end

local function escanear()
    if joinLock or not autoJoinMotor then return end
    local pm = player.PlayerGui:FindFirstChild("PetMenu")
    if not pm then return end
    
    local allFrames = {}; for _,v in ipairs(pm.Frame.ScrollingFrame:GetChildren()) do if v:IsA("Frame") and v.Visible then table.insert(allFrames, v) end end
    local limiteEscaneo = math.min(#allFrames, MAX_SERVERS_A_ESCANEAR)
    
    -- LÓGICA AUTOCLEAN
    if autoCleanEnabled then
        local firmasActuales = {}; for i = 1, limiteEscaneo do local lbl = allFrames[i]:FindFirstChild("TextLabel", false); if lbl and lbl.Text ~= "" then firmasActuales[lbl.Text] = true end end
        for firma, _ in pairs(usados) do
            if not firmasActuales[firma] then
                ausenciaContador[firma] = (ausenciaContador[firma] or 0) + 1
                if ausenciaContador[firma] >= INTENTOS_PARA_LIMPIAR then usados[firma] = nil; ausenciaContador[firma] = nil end
            else ausenciaContador[firma] = 0 end
        end
    end

    local candidatos = {}
    for i = 1, limiteEscaneo do
        local lbl = allFrames[i]:FindFirstChild("TextLabel", false)
        if lbl then
            for name, data in pairs(selectedData) do
                if data.enabled and lbl.Text:lower():find(name:lower(), 1, true) then
                    local val = parseSms(lbl.Text, name)
                    if val >= data.minVal and not usados[lbl.Text] then
                        table.insert(candidatos, {frame = allFrames[i], name = name, val = val, firma = lbl.Text})
                    end
                end
            end
        end
    end

    if #candidatos > 0 then
        table.sort(candidatos, function(a,b)
            local pA = table.find(priorityList, a.name) or 999; local pB = table.find(priorityList, b.name) or 999
            return pA < pB
        end)
        local mejor = candidatos[1]
        joinLock = true; usados[mejor.firma] = true; saveSettings()
        local btn = mejor.frame:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
        for i = 1, 150 do for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end end
        task.delay(2, function() joinLock = false end)
    end
end

