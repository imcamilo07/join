-- MOTOR LÓGICO Y BUCLE FÍSICO (MOUSEMOVEABS)
-- =========================================================

local function getVal(txt, target)
    local s = txt:lower():find(target:lower())
    if s then
        local sub = txt:sub(s + #target); local n = sub:match("(%d+%.?%d*)")
        local v = tonumber(n) or 0
        if sub:find("B") then v = v * 1000 end; return v
    end; return 0
end

task.spawn(function()
    while true do
        if autoJoin_Enabled then
            -- Si V1 está activo, hacemos el refresh físico primero
            if v1_Enabled and getgenv().mousemoveabs then
                getgenv().mousemoveabs(543, 154)
                getgenv().mouse1click()
                task.wait(0.2)
            end
            
            -- Escaneo de servidores
            local pm = player.PlayerGui:FindFirstChild("PetMenu")
            if pm and not joinLock then
                local items = pm.Frame.ScrollingFrame:GetChildren()
                for i = 1, MAX_SERVERS_A_ESCANEAR do
                    local v = items[i]
                    if v:IsA("Frame") and v.Visible then
                        local lbl = v:FindFirstChild("TextLabel", true)
                        if lbl then
                            for name, data in pairs(selectedData) do
                                if data.enabled and lbl.Text:lower():find(name:lower()) then
                                    local val = getVal(lbl.Text, name)
                                    if val >= data.minVal and not usados[lbl.Text] then
                                        joinLock = true; usados[lbl.Text] = true
                                        local b = v:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
                                        for _=1,50 do b.MouseButton1Click:Fire() end
                                        task.delay(3, function() joinLock = false end)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.01)
    end
end)

