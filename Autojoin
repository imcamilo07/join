-- TABS
local tabs = Instance.new("Frame", main)
tabs.Size = UDim2.new(1,0,0,30)
tabs.Position = UDim2.new(0,0,0,30)
tabs.BackgroundTransparency = 1

local tabWidth = 90
local spacing = 15
local totalWidth = (tabWidth * 3) + (spacing * 2)
local startX = (340 - totalWidth) / 2

local function makeTab(text,order)
	local t = Instance.new("TextButton", tabs)
	t.Size = UDim2.new(0,tabWidth,1,0)
	t.Position = UDim2.new(0, startX + (order * (tabWidth + spacing)), 0, 0)
	t.Text = text
	t.Font = Enum.Font.GothamBold
	t.TextSize = 14
	t.TextColor3 = Color3.fromRGB(160,160,160)
	t.BackgroundTransparency = 1
	return t
end

local autoBtn = makeTab("Autojoin",0)
local filterBtn = makeTab("Filters",1)
local miscBtn = makeTab("Misc",2)

-- UNDERLINE
local underline = Instance.new("Frame", tabs)
underline.Size = UDim2.new(0,50,0,2)
underline.BackgroundColor3 = Color3.fromRGB(0,170,255)

local function moveUnderline(btn)
    local goal = {
        Position = UDim2.new(0, btn.Position.X.Offset + 20, 1, -2)
    }

    local tween = TweenService:Create(
        underline,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        goal
    )

    tween:Play()
end

-- PAGES
local pages = Instance.new("Frame", main)
pages.Size = UDim2.new(1,-7,1,-56)
pages.Position = UDim2.new(0,4,0,66)
pages.BackgroundTransparency = 1

local function makePage()
	local f = Instance.new("Frame", pages)
	f.Size = UDim2.new(1,0,1,0)
	f.Visible = false
	f.BackgroundTransparency = 1
	return f
end

local autoPage = makePage()
local filterPage = makePage()
local miscPage = makePage()

autoPage.Visible = true
autoBtn.TextColor3 = Color3.fromRGB(255,255,255)
moveUnderline(autoBtn)

local function switch(page,btn)
    for _,p in pairs(pages:GetChildren()) do
        if p ~= page then
            p.Visible = false
        end
    end

    for _,b in pairs(tabs:GetChildren()) do
        if b:IsA("TextButton") then
            b.TextColor3 = Color3.fromRGB(160,160,160)
        end
    end

    page.Visible = true
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    moveUnderline(btn)
end

autoBtn.MouseButton1Click:Connect(function() switch(autoPage,autoBtn) end)
filterBtn.MouseButton1Click:Connect(function() switch(filterPage,filterBtn) end)
miscBtn.MouseButton1Click:Connect(function() switch(miscPage,miscBtn) end)

