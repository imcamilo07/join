local function makeTab(text, order, parent, tabsFrame)
    local t = Instance.new("TextButton", tabsFrame)
    local tabWidth = 90
    local spacing = 15
    local startX = (340 - ((tabWidth * 3) + (spacing * 2))) / 2
    t.Size = UDim2.new(0, tabWidth, 1, 0)
    t.Position = UDim2.new(0, startX + (order * (tabWidth + spacing)), 0, 0)
    t.Text = text
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextColor3 = Color3.fromRGB(160,160,160)
    t.BackgroundTransparency = 1
    return t
end

local function makePage(pagesFrame)
    local f = Instance.new("Frame", pagesFrame)
    f.Size = UDim2.new(1, 0, 1, 0)
    f.Visible = false
    f.BackgroundTransparency = 1
    return f
end

