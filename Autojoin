-- MOTOR V17 LOGIC
local function parseSms(txt, targetName)
    local sub = txt:sub(txt:lower():find(targetName:lower(), 1, true) + #targetName)
    local n, suf = sub:match("(%d+%.?%d*)([MB])")
    local val = tonumber(n) or 0
    return (suf == "B") and val * 1000 or val
end

local function escanear()
    if joinLock or not toggles.a then return end
    local pm = player.PlayerGui:FindFirstChild("jackk"); if not pm then return end
    local allFrames = {}; for _,v in ipairs(pm.Frame.ScrollingFrame:GetChildren()) do if v:IsA("Frame") and v.Visible then table.insert(allFrames, v) end end
    
    local candidatos, currentData = {}, toggles.ca and primeFilters or filters
    for i = 1, math.min(#allFrames, 5) do
        local lbl = allFrames[i]:FindFirstChild("TextLabel")
        if lbl and not usados[lbl.Text] then
            for name, data in pairs(currentData) do
                if data.enabled and lbl.Text:lower():find(name:lower(), 1, true) then
                    local val = parseSms(lbl.Text, name)
                    if val >= data.minVal then 
                        -- i es la posición (1 es arriba/más nuevo)
                        table.insert(candidatos, {frame = allFrames[i], name = name, val = val, firma = lbl.Text, pos = i}) 
                    end
                end
            end
        end
    end

    if #candidatos > 0 then
        table.sort(candidatos, function(a,b)
            local pA = table.find(priorityList, a.name) or 999
            local pB = table.find(priorityList, b.name) or 999
            if pA == pB then return a.pos < b.pos end -- V17 FIX: Prioridad al de arriba
            return pA < pB
        end)
        
        local mejor = candidatos[1]
        currentTarget.name = mejor.name; targetLbl.Text = mejor.name:sub(1,10).." ---"
        currentTarget.btn = mejor.frame:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
        
        joinLock = true; usados[mejor.firma] = true; saveData()
        addLog("JOIN: "..mejor.name.." "..mejor.val.."M/s")
        writefile(FILE_LAST_JOIN, mejor.name.." $"..mejor.val.."M/s")
        
        for i = 1, config.spamIntents do 
            if not player.PlayerGui:FindFirstChild("jackk") then break end
            for _,c in ipairs(getconnections(currentTarget.btn.MouseButton1Click)) do c:Fire() end 
            task.wait(config.spamDelay)
        end
        task.delay(1.5, function() joinLock = false end)
    end
end

