local function moveUnderline(btn)
    TweenService:Create(underline, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, btn.Position.X.Offset + 20, 1, -2)
    }):Play()
end

local function makePage()
    local f = Instance.new("Frame", pages)
    f.Size = UDim2.new(1,0,1,0)
    f.Visible = false
    f.BackgroundTransparency = 1
    return f
end

local autoPage = makePage()
local filterPage = makePage()
local miscPage = makePage()

local function switch(page, btn)
    for _,p in pairs(pages:GetChildren()) do p.Visible = (p == page) end
    for _,b in pairs(tabs:GetChildren()) do
        if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(160,160,160) end
    end
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    moveUnderline(btn)
end

local function makeTab(text, order, page)
    local t = Instance.new("TextButton", tabs)
    t.Size = UDim2.new(0,90,1,0)
    t.Position = UDim2.new(0, 12 + (order * 105), 0, 0)
    t.Text = text
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextColor3 = Color3.fromRGB(160,160,160)
    t.BackgroundTransparency = 1
    t.MouseButton1Click:Connect(function() switch(page, t) end)
    return t
end

local autoBtn = makeTab("Autojoin", 0, autoPage)
