local touchStartTime = 0
local startPosTouch
local moved = false

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        touchStartTime = tick()
        startPosTouch = input.Position
        moved = false
    end
end)

frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and startPosTouch then
        local delta = (input.Position - startPosTouch).Magnitude
        if delta > 10 then -- 👈 movimiento real
            moved = true
        end
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local duration = tick() - touchStartTime

        if duration < 0.2 and not moved then
            main.Visible = true
            miniGui.Enabled = false
        end
    end
end)
