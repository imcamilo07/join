end

local function loadData()
    if isfile(FILE_CONFIG) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_CONFIG)) end)
        if ok then
            toggles.v1 = data.toggles.v1; toggles.v2 = data.toggles.v2; toggles.ca = data.toggles.ca
            filters = data.filters or filters; primeFilters = data.primeFilters or primeFilters; priorityList = data.prio or priorityList; config = data.conf or config
            if data.mainPos then main.Position = UDim2.new(0.5, data.mainPos[1], 0.5, data.mainPos[2]) end
            if data.miniPos then frame.Position = UDim2.new(1, data.miniPos[1], 0, data.miniPos[2]) end
        end
    end
    if isfile(FILE_USADOS) then pcall(function() usados = HttpService:JSONDecode(readfile(FILE_USADOS)) end) end
    if isfile(FILE_LAST_JOIN) then createNotification("Last Join: " .. readfile(FILE_LAST_JOIN)) end
end

-- ARRASTRE
local function makeDraggable(obj, target, isMini)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = target.Position; moved = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart; if delta.Magnitude > 5 then moved = true end
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false; saveData()
            if not moved and isMini then fadeUI(main, true); miniGui.Enabled = false end
        end
    end)
end
