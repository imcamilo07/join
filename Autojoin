-- ==========================================
-- INTERCAMBIO ENTRE GUIS
-- ==========================================
close.MouseButton1Click:Connect(function()
    main.Visible = false
    miniGui.Enabled = true
end)

local touchStartTime = 0
local moved = false
frame.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch then touchStartTime = tick(); moved = false end end)
frame.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch then moved = true end end)
frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and (tick() - touchStartTime) < 0.3 and not moved then
        main.Visible = true
        miniGui.Enabled = false
    end
end)

-- ==========================================
-- CARGA FINAL DE POSICIONES
-- ==========================================
if isfile("atlas_gui.json") then
    pcall(function()
        local data = HttpService:JSONDecode(readfile("atlas_gui.json"))
        if data.main then
            main.Position = UDim2.new(0.5, data.main.X, 0.5, data.main.Y)
        end
        if data.mini then
            local newPos = UDim2.new(1, data.mini.X, 0, data.mini.Y)
            frame.Position = newPos
            shadow.Position = newPos
        end
    end)
end

