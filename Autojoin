-- PERSISTENCIA DE DATOS (NO POSICIONES)
local function loadSettings()
    if isfile(FILE_CONFIG) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_CONFIG)) end)
        if ok then
            selectedData = data.sel or {}
            priorityList = data.prio or priorityList
            autoCleanEnabled = data.clean or false
        end
    end
    for _, name in ipairs(ALL_OBJECTS) do
        if not selectedData[name] then selectedData[name] = {enabled = false, minVal = 0} end
    end
end

local function saveSettings()
    local data = {
        sel = selectedData,
        prio = priorityList,
        clean = autoCleanEnabled
    }
    writefile(FILE_CONFIG, HttpService:JSONEncode(data))
end

