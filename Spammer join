scroll.Size = UDim2.new(0.9, 0, 0.75, 0); scroll.Position = UDim2.new(0.05, 0, 0.18, 0); scroll.BackgroundTransparency = 1; scroll.CanvasSize = UDim2.new(0,0,0,0); scroll.ScrollBarThickness = 2

local function updateList()
    scroll:ClearAllChildren()
    local pm = PlayerGui:FindFirstChild("PetMenu")
    if not pm then return end
    local sc = pm.Frame:FindFirstChild("ScrollingFrame")
    if not sc then return end

    local allFrames = {}
    for _, v in ipairs(sc:GetChildren()) do
        if v:IsA("Frame") and v.Visible then table.insert(allFrames, v) end
    end

    local y = 0
    -- LÓGICA MODIFICADA: Tomamos solo los PRIMEROS 5 (TOP 5)
    local limite = math.min(#allFrames, 5)
    for i = 1, limite do
        local f = allFrames[i]
        local txt = f:FindFirstChild("TextLabel") and f.TextLabel.Text or "Unknown"
        
        local b = Instance.new("TextButton", scroll)
        b.Size = UDim2.new(1, -5, 0, 30); b.Position = UDim2.new(0, 0, 0, y)
        b.BackgroundColor3 = (targetServerManual == f) and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(40, 40, 45)
        b.Text = "#" .. i .. " " .. txt:sub(1, 25); b.TextSize = 8; b.TextColor3 = Color3.new(1,1,1); b.Font = "SourceSans"
        Instance.new("UICorner", b)
        
        b.MouseButton1Click:Connect(function()
            targetServerManual = f
            updateList() -- Resaltar selección
        end)
        y = y + 33
    end
    scroll.CanvasSize = UDim2.new(0,0,0,y)
end

settingsBtn.MouseButton1Click:Connect(function() selector.Visible = not selector.Visible; if selector.Visible then updateList() end end)
closeSelector.MouseButton1Click:Connect(function() selector.Visible = false end)
refreshBtn.MouseButton1Click:Connect(updateList)

-- ================= LÓGICA DE DISPARO =================

local function getTarget()
    -- Si hay uno manual seleccionado, lo usamos
    if targetServerManual and targetServerManual.Parent then return targetServerManual end
    
    -- Si no hay selección, por defecto toma el primero de la lista (Top 1)
    local pm = PlayerGui:FindFirstChild("PetMenu")
    local sc = pm and pm.Frame:FindFirstChild("ScrollingFrame")
    if sc then
        for _, v in ipairs(sc:GetChildren()) do 
            if v:IsA("Frame") and v.Visible then return v end 
        end
    end
    return nil
end

local function startSpam()
    local maxAtt = tonumber(attInput.Text) or 2000
    local cps = tonumber(delayInput.Text) or 10
    local waitTime = 1 / cps
    
    local target = getTarget()
    if not target then isSpamming = false; return end

    local inner = target:FindFirstChildWhichIsA("Frame")
    local btn = inner and inner:FindFirstChildWhichIsA("TextButton")
    if not btn then isSpamming = false; return end

    while isSpamming and currentAttempts < maxAtt do
        currentAttempts = currentAttempts + 1
        counter.Text = currentAttempts .. " / " .. maxAtt
        
        for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end
        task.wait(waitTime)
    end
    
    isSpamming = false
    spamBtn.Text = "SPAM JOIN"
    spamBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    currentAttempts = 0
end

spamBtn.MouseButton1Click:Connect(function()
    if isSpamming then
        isSpamming = false
        spamBtn.Text = "SPAM JOIN"
        spamBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        isSpamming = true; currentAttempts = 0
        spamBtn.Text = "STOP"; spamBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        task.spawn(startSpam)
    end
end)

