local function loadData()
    if isfile(FILE_DATA) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_DATA)) end)
        if ok then 
            btnCPos = UDim2.new(data.pos.X.Scale, data.pos.X.Offset, data.pos.Y.Scale, data.pos.Y.Offset)
            selectedData = data.sel or {}
            primeSelectedData = data.primeSel or {} -- Cargar lista PRIME
            priorityList = data.prio or priorityList
        end
    end
    if isfile(FILE_USADOS) then pcall(function() usados = HttpService:JSONDecode(readfile(FILE_USADOS)) end) end
end

local function saveData()
    local data = {
        pos = {X = {Scale = btnCPos.X.Scale, Offset = btnCPos.X.Offset}, Y = {Scale = btnCPos.Y.Scale, Offset = btnCPos.Y.Offset}},
        sel = selectedData,
        primeSel = primeSelectedData, -- Guardar lista PRIME
        prio = priorityList,
        auto = false 
    }
    writefile(FILE_DATA, HttpService:JSONEncode(data))
    writefile(FILE_USADOS, HttpService:JSONEncode(usados))
end

