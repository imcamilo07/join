-- ================= MOTOR =================
local function parseSms(txt)
    local n = txt:match("(%d+%.?%d*)")
    local val = tonumber(n) or 0
    if txt:find("B") then val = val * 1000 end
    return val
end

local function escanear()
    if joinLock or not autoRefresh then return end
    local pm = PlayerGui:FindFirstChild("PetMenu")
    if not pm then return end
    
    local frames = {}
    for _,v in ipairs(pm.Frame.ScrollingFrame:GetChildren()) do 
        if v:IsA("Frame") and v.Visible then table.insert(frames, v) end 
    end
    
    -- LÓGICA AUTO-CLEAN CON DEBOUNCE (Frames 11-15)
    local totalFrames = #frames
    local zonaInicio = math.max(1, totalFrames - MAX_SERVERS_A_ESCANEAR + 1)
    local algoEnZona = false
    
    for i = zonaInicio, totalFrames do
        local lbl = frames[i]:FindFirstChild("TextLabel", false)
        if lbl and lbl.Text ~= "" then algoEnZona = true; break end
    end
    
    if not algoEnZona then
        if zonaVaciaDesde == 0 then zonaVaciaDesde = tick() end
        if (tick() - zonaVaciaDesde) >= CLEAN_DEBOUNCE and next(usados) ~= nil then
            usados = {}; saveData()
            logL.Text = "CLR"; task.delay(0.5, function() logL.Text = "..." end)
            zonaVaciaDesde = 0
        end
    else
        zonaVaciaDesde = 0 -- Resetear timer si aparece algo
    end

    local candidatos = {}
    for i = zonaInicio, totalFrames do
        local lbl = frames[i]:FindFirstChild("TextLabel", false)
        if lbl then
            local txt = lbl.Text:lower()
            for name, data in pairs(selectedData) do
                if data.enabled and txt:find(name:lower(), 1, true) then
                    local val = parseSms(lbl.Text)
                    if val >= data.minVal and not usados[lbl.Text] then
                        table.insert(candidatos, {frame = frames[i], name = name, val = val, firma = lbl.Text})
                    end
                end
            end
        end
    end

    if #candidatos > 0 then
        table.sort(candidatos, function(a,b)
            local pA = table.find(priorityList, a.name) or 999
            local pB = table.find(priorityList, b.name) or 999
            return pA < pB
        end)
        
        local mejor = candidatos[1]
        joinLock = true; usados[mejor.firma] = true; saveData()
        writefile(FILE_LAST_JOIN, mejor.name .. " $" .. mejor.val .. "M/s")
        
        local btn = mejor.frame:FindFirstChildWhichIsA("Frame"):FindFirstChildWhichIsA("TextButton")
        for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
        task.delay(1.5, function() joinLock = false end)
    end
end

task.spawn(function()
