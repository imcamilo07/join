local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local lp = Players.LocalPlayer

-- CONFIGURACIÓN DE SEGURIDAD
local REMOTE_NAME = "352aad58-c786-4998-886b-3e4fa390721e"
local KEY_SEGURIDAD = "78a772b6-9e1c-4827-ab8b-04a07838f298"
local EFECTOS = {"rocket", "ragdoll", "balloon"}
local indiceGlobal = 1

local Prioridad = {
    ["Skibidi Toilet"] = 100, ["Strawberry Elephant"] = 99, ["Meowl"] = 98,
    ["Dragon Cannelloni"] = 97, ["Dragon Gingerini"] = 96, ["Cerberus"] = 95,
    ["Capitano Moby"] = 94, ["Headless Horseman"] = 93, ["Burguro and Fryuro"] = 92,
    ["Cooki and Milki"] = 91, ["La Casa Boo"] = 90, ["Reinito Sleighito"] = 89,
    ["Gingerat Gerat"] = 88, ["Spooky and Pumpky"] = 87, ["Fragrama and Chocrama"] = 86,
    ["La Supreme Combinasion"] = 85, ["La Secret Combinasion"] = 84, ["Garama and Madundung"] = 83,
    ["Lavadorito Spinito"] = 82, ["Ketupat Kepat"] = 81, ["Tictac Sahur"] = 80,
    ["Tang Tang Keletang"] = 79, ["Ketchuru and Musturu"] = 78,
    ["Bandito Bobritto"] = 110
}

-- INTERFAZ
local sg = Instance.new("ScreenGui", lp.PlayerGui)
sg.Name = "AdminPanel_Final_v3"
sg.ResetOnSpawn = false

local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0, 170, 0, 32)
main.Position = UDim2.new(0.5, 126, 0.5, -152) 
main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
main.BorderSizePixel = 0
main.ClipsDescendants = true
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 5)

local listFrame = Instance.new("Frame", main)
listFrame.Size = UDim2.new(1, -6, 0, 0)
listFrame.Position = UDim2.new(0, 3, 0, 38)
listFrame.BackgroundTransparency = 1
listFrame.Visible = false

local layout = Instance.new("UIListLayout", listFrame)
layout.Padding = UDim.new(0, 3)
layout.SortOrder = Enum.SortOrder.LayoutOrder

-- Ajuste de tamaño dinámico
local function updateMainSize()
    if listFrame.Visible then
        local contentHeight = layout.AbsoluteContentSize.Y
        main:TweenSize(UDim2.new(0, 170, 0, math.min(contentHeight + 45, 250)), "Out", "Quart", 0.2, true)
    else
        main:TweenSize(UDim2.new(0, 170, 0, 32), "Out", "Quart", 0.2, true)
    end
end

-- Función para buscar el nombre en Rendered
local function getObjetoNombre()
    local folder = Workspace:FindFirstChild("RenderedMovingAnimals")
    if folder then
        for _, obj in ipairs(folder:GetChildren()) do
            if Prioridad[obj.Name] then return obj.Name end
        end
    end
    return nil
end

local function addPlayer(p)
    if not p or p == lp then return end
   
    local card = Instance.new("TextButton", listFrame)
    card.Size = UDim2.new(1, 0, 0, 32)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    card.Text = ""
    card.Name = p.Name
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 4)

    local profile = Instance.new("ImageLabel", card)
    profile.Size = UDim2.new(0, 24, 0, 24)
    profile.Position = UDim2.new(0, 4, 0.5, -12)
    profile.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    Instance.new("UICorner", profile).CornerRadius = UDim.new(1, 0)

    local dName = Instance.new("TextLabel", card)
    dName.Size = UDim2.new(1, -35, 0, 12); dName.Position = UDim2.new(0, 34, 0, 4)
    dName.Text = p.DisplayName; dName.TextColor3 = Color3.new(1, 1, 1); dName.Font = Enum.Font.GothamBold; dName.TextSize = 9; dName.TextXAlignment = Enum.TextXAlignment.Left; dName.BackgroundTransparency = 1

    local uName = Instance.new("TextLabel", card)
    uName.Size = UDim2.new(1, -35, 0, 12); uName.Position = UDim2.new(0, 34, 0, 16)
    uName.TextColor3 = Color3.fromRGB(160, 160, 160); uName.Font = Enum.Font.Gotham; uName.TextSize = 7; uName.TextScaled = true; uName.TextXAlignment = Enum.TextXAlignment.Left; uName.BackgroundTransparency = 1

    local function updateUI()
        if not p.Parent or not card then return end
        local mineral = p:GetAttribute("StealingIndex")
        local estaRobando = p:GetAttribute("Stealing")
        local nombreFinal = (mineral and mineral ~= "") and mineral or (estaRobando and getObjetoNombre())
        
        uName.Text = "@" .. p.Name .. (nombreFinal and (" | " .. nombreFinal) or (estaRobando and " | ¡Cargando!" or ""))
        card.LayoutOrder = -(Prioridad[nombreFinal] or (estaRobando and 50) or 0)
        card.BackgroundColor3 = estaRobando and Color3.fromRGB(85, 20, 20) or Color3.fromRGB(25, 25, 25)
    end

    p:GetAttributeChangedSignal("StealingIndex"):Connect(updateUI)
    p:GetAttributeChangedSignal("Stealing"):Connect(updateUI)
    updateUI()

    card.MouseButton1Click:Connect(function()
        local remote = ReplicatedStorage.Packages.Net:FindFirstChild("RE/" .. REMOTE_NAME, true)
        if remote then
            remote:FireServer(KEY_SEGURIDAD, p, EFECTOS[indiceGlobal])
            indiceGlobal = (indiceGlobal % #EFECTOS) + 1
        end
    end)
end

-- FUNCIÓN DE REFRESCO: Ahora solo crea objetos si está visible
local function refresh()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    -- Solo cargamos jugadores si el menú está desplegado
    if listFrame.Visible then
        for _, p in ipairs(Players:GetPlayers()) do
            addPlayer(p)
        end
    end
    updateMainSize()
end

local titleBtn = Instance.new("TextButton", main)
titleBtn.Size = UDim2.new(1, 0, 0, 32); titleBtn.BackgroundTransparency = 1; titleBtn.Text = "Admin Spammer ▼"; titleBtn.TextColor3 = Color3.new(1, 1, 1); titleBtn.Font = Enum.Font.GothamBold; titleBtn.TextSize = 10

titleBtn.MouseButton1Click:Connect(function()
    listFrame.Visible = not listFrame.Visible
    refresh() -- Esto limpia o carga los jugadores al instante
end)

-- Solo actualizamos si lo estás viendo
Players.PlayerAdded:Connect(function() if listFrame.Visible then refresh() end end)
Players.PlayerRemoving:Connect(function() if listFrame.Visible then refresh() end end)
layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateMainSize)
