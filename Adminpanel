local function buscarObjetoFisico()
    local folder = Workspace:FindFirstChild("RenderedMovingAnimals")
    if folder then
        for _, obj in ipairs(folder:GetChildren()) do
            if Prioridad[obj.Name] then return obj.Name end
        end
    end
    return nil
end

local function addPlayer(p)
    if not p or p == lp then return end
    
    local card = Instance.new("TextButton", listFrame)
    card.Size = UDim2.new(1, 0, 0, 32)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    card.Text = ""
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 4)

    -- CARGA DE FOTO: Solo ocurre cuando se crea la tarjeta (al abrir el panel)
    local profile = Instance.new("ImageLabel", card)
    profile.Size = UDim2.new(0, 24, 0, 24)
    profile.Position = UDim2.new(0, 4, 0.5, -12)
    profile.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    Instance.new("UICorner", profile).CornerRadius = UDim.new(1, 0)

    local dName = Instance.new("TextLabel", card)
    dName.Size = UDim2.new(1, -35, 0, 12); dName.Position = UDim2.new(0, 34, 0, 4)
    dName.Text = p.DisplayName; dName.TextColor3 = Color3.new(1, 1, 1)
    dName.Font = "GothamBold"; dName.TextSize = 9; dName.TextXAlignment = "Left"; dName.BackgroundTransparency = 1

    local uName = Instance.new("TextLabel", card)
    uName.Size = UDim2.new(1, -35, 0, 12); uName.Position = UDim2.new(0, 34, 0, 16)
    uName.TextColor3 = Color3.fromRGB(160, 160, 160); uName.Font = "Gotham"; uName.TextSize = 7; uName.BackgroundTransparency = 1
    uName.TextXAlignment = "Left"; uName.TextScaled = true

    local function updateUI()
        if not card or not p.Parent then return end
        local mineral = p:GetAttribute("StealingIndex")
        local estaRobando = p:GetAttribute("Stealing")
        
        -[span_11](start_span)[span_12](start_span)[span_13](start_span)- Si StealingIndex es nil, escanea la carpeta RenderedMovingAnimals[span_11](end_span)[span_12](end_span)[span_13](end_span)
        local nombreFinal = (mineral and mineral ~= "") and mineral or (estaRobando and buscarObjetoFisico())
        
        uName.Text = "@" .. p.Name .. (nombreFinal and (" | " .. nombreFinal) or "")
        card.LayoutOrder = -(Prioridad[nombreFinal] or (estaRobando and 50) or 0)
        card.BackgroundColor3 = estaRobando and Color3.fromRGB(85, 20, 20) or Color3.fromRGB(25, 25, 25)
    end

    p:GetAttributeChangedSignal("Stealing"):Connect(updateUI)
    p:GetAttributeChangedSignal("StealingIndex"):Connect(updateUI)
    updateUI()

    card.MouseButton1Click:Connect(function()
        local remote = ReplicatedStorage.Packages.Net:FindFirstChild("RE/" .. REMOTE_NAME, true)
        if remote then
            remote:FireServer(KEY_SEGURIDAD, p, EFECTOS[indiceGlobal])
            indiceGlobal = (indiceGlobal % #EFECTOS) + 1
        end
    end)
end

