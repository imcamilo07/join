    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        visualCircle.Size = Vector3.new(0.1, rangeValue * 2, rangeValue * 2)
        visualCircle.CFrame = (hrp.CFrame * CFrame.new(0, -3, 0)) * CFrame.Angles(0, 0, math.rad(90))
        visualCircle.Transparency = proximityEnabled and 0.8 or 1
    end
end)

task.spawn(function()
    while true do
        task.wait(0.25)
        if listFrame.Visible then
            for card, upFunc in pairs(updateFunctions) do upFunc() end
        end

        if proximityEnabled then
            local char = lp.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local myPos = hrp.Position
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local p_hrp = p.Character.HumanoidRootPart
                        local dist = (myPos - p_hrp.Position).Magnitude
                        
                        if dist <= rangeValue then
                            if not yaDisparados[p.Name] then
                                yaDisparados[p.Name] = true
                                task.spawn(function()
                                    for _, ef in ipairs(EFECTOS_PROX) do
                                        local cdMax = TIEMPOS_ESPECIFICOS[ef] or 60
                                        if tick() - (cooldownEfectos[ef] or 0) > cdMax then
                                            if (hrp.Position - p_hrp.Position).Magnitude <= rangeValue then
                                                cooldownEfectos[ef] = tick()
                                                disparar(p.Name, ef)
                                                task.wait(0.05) 
                                            else break end
                                        end
                                    end
                                end)
                            end
                        else
                            yaDisparados[p.Name] = nil
                        end
                    end
                end
            end
        end
    end
end)

