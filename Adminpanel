-- 2. ESCÁNER DE PLOTS (Optimizado: Solo corre si el menú está abierto)
local mapaDeDuenos = {}
local function escanearPlots()
    mapaDeDuenos = {}
    for _, carpeta in ipairs(Plots:GetChildren()) do
        local sign = carpeta:FindFirstChild("PlotSign", true)
        local label = sign and sign:FindFirstChild("TextLabel", true)
        if label then
            for _, p in ipairs(Players:GetPlayers()) do
                if string.find(string.lower(label.Text), string.lower(p.Name)) or 
                   string.find(string.lower(label.Text), string.lower(p.DisplayName)) then
                    mapaDeDuenos[carpeta.Name] = p
                    break
                end
            end
        end
    end
end

-- 3. FUNCIÓN DE DISPARO
local function disparar(targetName, efecto)
    local admin = pgui:FindFirstChild("AdminPanel") and pgui.AdminPanel:FindFirstChild("AdminPanel")
    if not admin then return end
    local pBtn = admin.Profiles.ScrollingFrame:FindFirstChild(targetName)
    
    local eBtn = admin.Content.ScrollingFrame:FindFirstChild(efecto)
    if pBtn and eBtn then
        for _, c in ipairs(getconnections(pBtn.Activated)) do c:Fire() end
        task.wait(0.1)
        for _, c in ipairs(getconnections(eBtn.Activated)) do c:Fire() end
    end
end

