local function refresh()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    if listFrame.Visible then
        for _, p in ipairs(Players:GetPlayers()) do
            addPlayer(p)
        end
    end
    updateMainSize()
end

