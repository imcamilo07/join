-- 2. FUNCIÓN DE DISPARO INSTANTÁNEO (USANDO ACTIVATED)
local function disparar(obj)
    if not obj then return end
    -- Disparar el evento Activated directamente (El que funcionó en el test)
    local conexiones = getconnections(obj.Activated)
    for _, conn in ipairs(conexiones) do
        conn:Fire()
    end
end

-- 3. APERTURA Y CIERRE FLASH (Carga el panel sin mostrarlo)
local function abrirCerrarFlash()
    local leftFolder = pgui:WaitForChild("TopbarStandard"):WaitForChild("Holders"):WaitForChild("Left")
    
    for _, w in ipairs(leftFolder:GetChildren()) do
        if w.Name == "Widget" then
            local iconImage = w:FindFirstChild("IconImage", true)
            if iconImage and string.find(tostring(iconImage.Image), AP_IMAGE_ID) then
                local clickRegion = w:FindFirstChild("ClickRegion", true)
                if clickRegion then
                    -- Abrir
                    for _, conn in ipairs(getconnections(clickRegion.MouseButton1Click)) do conn:Fire() end
                    task.wait(0.1)
                    -- Cerrar inmediatamente
                    for _, conn in ipairs(getconnections(clickRegion.MouseButton1Click)) do conn:Fire() end
                    print("⚡ Admin Panel cargado en segundo plano.")
                    break
                end
            end
        end
    end
end

-- 4. GUI DE CONTROL (SIN CAMBIOS EN DISEÑO)
local sg = Instance.new("ScreenGui", pgui)
sg.Name = "AdminSpammer_Activated_Fix"
sg.ResetOnSpawn = false

local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0, 170, 0, 32)
main.Position = UDim2.new(0.5, 126, 0.5, -152) 
main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
main.BorderSizePixel = 0
main.ClipsDescendants = true
Instance.new("UICorner", main)

local listFrame = Instance.new("Frame", main)
listFrame.Size = UDim2.new(1, -6, 0, 0)
listFrame.Position = UDim2.new(0, 3, 0, 38)
listFrame.BackgroundTransparency = 1
listFrame.Visible = false

local layout = Instance.new("UIListLayout", listFrame)
layout.Padding = UDim.new(0, 3)
layout.SortOrder = Enum.SortOrder.LayoutOrder

local function updateMainSize()
    if listFrame.Visible then
        main:TweenSize(UDim2.new(0, 170, 0, math.min(layout.AbsoluteContentSize.Y + 45, 250)), "Out", "Quart", 0.2, true)
    else
        main:TweenSize(UDim2.new(0, 170, 0, 32), "Out", "Quart", 0.2, true)
    end
end

local function addPlayer(p)
    if not p or p == lp then return end
    local card = Instance.new("TextButton", listFrame)
    card.Size = UDim2.new(1, 0, 0, 32)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    card.Text = ""
    card.Name = p.Name
    Instance.new("UICorner", card)

    local dName = Instance.new("TextLabel", card)
    dName.Size = UDim2.new(1, -35, 0, 12)
    dName.Position = UDim2.new(0, 34, 0, 4)
    dName.Text = p.DisplayName
    dName.TextColor3 = Color3.new(1, 1, 1)
    dName.Font = Enum.Font.GothamBold
    dName.TextSize = 9
    dName.TextXAlignment = "Left"
    dName.BackgroundTransparency = 1

    local uName = Instance.new("TextLabel", card)
    uName.Size = UDim2.new(1, -35, 0, 12)
    uName.Position = UDim2.new(0, 34, 0, 16)
    uName.TextColor3 = Color3.fromRGB(160, 160, 160)
    uName.Font = Enum.Font.Gotham
    uName.TextSize = 7
    uName.TextScaled = true
    uName.TextXAlignment = "Left"
    uName.BackgroundTransparency = 1

    local function updateUI()
        if not p.Parent or not card then return end
        local mineral = p:GetAttribute("StealingIndex")
        uName.Text = "@" .. p.Name .. (mineral and (" | " .. mineral) or "")
        card.LayoutOrder = -(Prioridad[mineral] or 0)
        card.BackgroundColor3 = p:GetAttribute("Stealing") and Color3.fromRGB(85, 20, 20) or Color3.fromRGB(25, 25, 25)
    end

    p:GetAttributeChangedSignal("StealingIndex"):Connect(updateUI)
    p:GetAttributeChangedSignal("Stealing"):Connect(updateUI)
    updateUI()

    -- LÓGICA DE CLIC ACTUALIZADA
    card.MouseButton1Click:Connect(function()
        local adminFrame = pgui:FindFirstChild("AdminPanel") and pgui.AdminPanel:FindFirstChild("AdminPanel")
        if not adminFrame then return end
        
        local profScroll = adminFrame.Profiles.ScrollingFrame
        local contScroll = adminFrame.Content.ScrollingFrame
        
        local targetBtn = profScroll:FindFirstChild(p.Name)
        local effectBtn = contScroll:FindFirstChild(EFECTOS[indiceGlobal])
        
        if targetBtn and effectBtn then
            disparar(targetBtn) -- Selecciona jugador
            disparar(effectBtn) -- Aplica efecto
            indiceGlobal = (indiceGlobal % #EFECTOS) + 1
        end
    end)
end

local function refresh()
    for _, child in ipairs(listFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, p in ipairs(Players:GetPlayers()) do addPlayer(p) end
    updateMainSize()
end

local titleBtn = Instance.new("TextButton", main)
titleBtn.Size = UDim2.new(1, 0, 0, 32)
titleBtn.Text = "Admin Spammer ▼"
titleBtn.TextColor3 = Color3.new(1, 1, 1)
titleBtn.Font = Enum.Font.GothamBold
titleBtn.BackgroundTransparency = 1
titleBtn.MouseButton1Click:Connect(function()
    listFrame.Visible = not listFrame.Visible
    if listFrame.Visible then refresh() else updateMainSize() end
end)

-- 5. EJECUCIÓN
abrirCerrarFlash()
Players.PlayerAdded:Connect(refresh)
Players.PlayerRemoving:Connect(refresh)
