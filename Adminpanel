-- ==========================================
-- PROXIMITY AP vFINAL: PIES FIX & SECUENCIA
-- ==========================================

local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local pgui = lp:WaitForChild("PlayerGui")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

-- 1. CONFIGURACIÓN
local EFECTOS_SECUENCIA = {"inverse", "jail", "tiny", "morph", "jumpscare"}
local cooldownEfectos = {
    ["inverse"] = 0, ["jail"] = 0, ["tiny"] = 0, 
    ["morph"] = 0, ["jumpscare"] = 0, ["ALL"] = 0
}

local proximityEnabled = false
local rangeValue = 50 

-- 2. CÍRCULO VISUAL (AJUSTADO A LOS PIES)
local visualCircle = Instance.new("Part")
visualCircle.Shape = Enum.PartType.Cylinder
visualCircle.Transparency = 1
visualCircle.Color = Color3.fromRGB(255, 0, 80)
visualCircle.Material = Enum.Material.ForceField
visualCircle.CanCollide = false
visualCircle.Anchored = true
visualCircle.CastShadow = false
visualCircle.Parent = workspace

-- 3. FUNCIÓN DE DISPARO
local function dispararEfecto(targetName, efecto)
    local admin = pgui:FindFirstChild("AdminPanel") and pgui.AdminPanel:FindFirstChild("AdminPanel")
    if not admin then return end
    local pBtn = admin.Profiles.ScrollingFrame:FindFirstChild(targetName)
    if not pBtn then return end

    if efecto == "ALL" then
        for _, ef in ipairs(EFECTOS_SECUENCIA) do
            local eBtn = admin.Content.ScrollingFrame:FindFirstChild(ef)
            if eBtn then
                for _, c in ipairs(getconnections(pBtn.Activated)) do c:Fire() end
                task.wait(0.05)
                for _, c in ipairs(getconnections(eBtn.Activated)) do c:Fire() end
            end
        end
    else
        local eBtn = admin.Content.ScrollingFrame:FindFirstChild(efecto)
        if eBtn then
            for _, c in ipairs(getconnections(pBtn.Activated)) do c:Fire() end
            task.wait(0.1)
            for _, c in ipairs(getconnections(eBtn.Activated)) do c:Fire() end
        end
    end
end

-- 4. GUI (DRAGGABLE & POSITION SAVED)
local sg = Instance.new("ScreenGui", pgui)
sg.Name = "ProximityAP_Final"
sg.ResetOnSpawn = false

local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0, 220, 0, 110)
main.Position = _G.SpammerPos or UDim2.new(0.5, -450, 0.5, 0)
main.BackgroundColor3 = Color3.fromRGB(15, 10, 25)
main.Active = true
main.Draggable = true
Instance.new("UICorner", main)

main:GetPropertyChangedSignal("Position"):Connect(function() _G.SpammerPos = main.Position end)

local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, -10, 0, 30)
title.Position = UDim2.new(0, 10, 0, 0)
title.Text = "Proximity AP Final"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 13
title.BackgroundTransparency = 1
title.TextXAlignment = "Left"

local toggle = Instance.new("TextButton", main)
toggle.Size = UDim2.new(0, 35, 0, 18)
toggle.Position = UDim2.new(1, -45, 0, 7)
toggle.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggle.Text = ""
Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

local knob = Instance.new("Frame", toggle)
knob.Size = UDim2.new(0, 14, 0, 14)
knob.Position = UDim2.new(0, 2, 0.5, -7)
knob.BackgroundColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

toggle.MouseButton1Click:Connect(function()
    proximityEnabled = not proximityEnabled
    toggle.BackgroundColor3 = proximityEnabled and Color3.fromRGB(255, 0, 80) or Color3.fromRGB(40, 40, 40)
    knob:TweenPosition(proximityEnabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), "Out", "Quart", 0.2, true)
    visualCircle.Transparency = proximityEnabled and 0.8 or 1
end)

local rangeLabel = Instance.new("TextLabel", main)
rangeLabel.Size = UDim2.new(1, -20, 0, 20)
rangeLabel.Position = UDim2.new(0, 10, 0, 45)
rangeLabel.Text = "Defense Range: 50 studs"
rangeLabel.TextColor3 = Color3.fromRGB(255, 180, 200)
rangeLabel.Font = Enum.Font.GothamMedium
rangeLabel.TextSize = 11
rangeLabel.BackgroundTransparency = 1
rangeLabel.TextXAlignment = "Left"

local sliderBack = Instance.new("Frame", main)
sliderBack.Size = UDim2.new(1, -20, 0, 4)
sliderBack.Position = UDim2.new(0, 10, 0, 75)
sliderBack.BackgroundColor3 = Color3.fromRGB(50, 30, 40)
Instance.new("UICorner", sliderBack)

local sliderFill = Instance.new("Frame", sliderBack)
sliderFill.Size = UDim2.new(0.25, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(255, 50, 100)
Instance.new("UICorner", sliderFill)

local sliderBtn = Instance.new("TextButton", sliderFill)
sliderBtn.Size = UDim2.new(0, 12, 0, 12)
sliderBtn.Position = UDim2.new(1, -6, 0.5, -6)
sliderBtn.BackgroundColor3 = Color3.new(1, 1, 1)
sliderBtn.Text = ""
Instance.new("UICorner", sliderBtn).CornerRadius = UDim.new(1, 0)

local dragging = false
local function updateSlider()
    local mousePos = UIS:GetMouseLocation().X
    local relativePos = mousePos - sliderBack.AbsolutePosition.X
    local percentage = math.clamp(relativePos / sliderBack.AbsoluteSize.X, 0, 1)
    sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    rangeValue = math.floor(percentage * 200)
    rangeLabel.Text = "Defense Range: " .. rangeValue .. " studs"
end

sliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider() end
end)

-- 5. BUCLE DE ESCANEO
RunService.Heartbeat:Connect(function()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- POSICIÓN DEL CÍRCULO EN LOS PIES (Offset -3 en Y)
        visualCircle.Size = Vector3.new(0.1, rangeValue * 2, rangeValue * 2)
        visualCircle.CFrame = (hrp.CFrame * CFrame.new(0, -3, 0)) * CFrame.Angles(0, 0, math.rad(90))
        
        if proximityEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    
                    if dist <= 40 then
                        if tick() - cooldownEfectos["ALL"] > 60 then
                            cooldownEfectos["ALL"] = tick()
                            dispararEfecto(p.Name, "ALL")
                        end
                    elseif dist <= rangeValue then
                        -- Secuencia inteligente: Busca el primer efecto de la lista que no esté en cooldown
                        for _, ef in ipairs(EFECTOS_SECUENCIA) do
                            if tick() - cooldownEfectos[ef] > 60 then
                                cooldownEfectos[ef] = tick()
                                dispararEfecto(p.Name, ef)
                                break -- Dispara solo uno y sale del loop para este jugador
                            end
                        end
                    end
                end
            end
        end
    end
end)

print("🛡️ Proximity AP Final cargado. Círculo en pies y secuencia optimizada.")
