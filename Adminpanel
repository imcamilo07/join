-- 2. FUNCIÓN DE INVISIBILIDAD TOTAL
local function aplicarInvisibilidad(obj)
    if obj:IsA("GuiObject") then
        obj.BackgroundTransparency = 1
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            obj.TextTransparency = 1
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            obj.ImageTransparency = 1
        end
    end
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("GuiObject") then
            child.BackgroundTransparency = 1
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                child.TextTransparency = 1
            elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                child.ImageTransparency = 1
            end
        end
        if child:IsA("UIStroke") then
            child.Transparency = 1
            child.Enabled = false
        end
    end
end

-- 3. EJECUCIÓN DE CLIC VIRTUAL
local function ejecutarClicSeguro(obj, posDestino, carpetaOriginal)
    if obj then
        local tempGui = pgui:FindFirstChild("TempClickLayer") or Instance.new("ScreenGui", pgui)
        tempGui.Name = "TempClickLayer"
        tempGui.IgnoreGuiInset = true

        local originalPos = obj.Position
        local originalSize = obj.AbsoluteSize
        
        obj.Parent = tempGui
        obj.Position = posDestino
        obj.Size = UDim2.new(0, originalSize.X, 0, originalSize.Y)
        obj.Visible = true
        aplicarInvisibilidad(obj)
        
        task.wait(0.05)
        
        local x = obj.AbsolutePosition.X + (obj.AbsoluteSize.X / 2)
        local y = obj.AbsolutePosition.Y + (obj.AbsoluteSize.Y / 2) + 58
        
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        
        task.wait(0.05)
        obj.Parent = carpetaOriginal
        obj.Position = originalPos
    end
end

-- 4. APERTURA Y OCULTACIÓN CON FUERZA (La parte que pediste)
local function abrirYEsconderAP()
    local leftFolder = pgui:WaitForChild("TopbarStandard"):WaitForChild("Holders"):WaitForChild("Left")
    
    for _, w in ipairs(leftFolder:GetChildren()) do
        if w.Name == "Widget" then
            local iconImage = w:FindFirstChild("IconImage", true)
            if iconImage and string.find(tostring(iconImage.Image), AP_IMAGE_ID) then
                local clickRegion = w:FindFirstChild("ClickRegion", true)
                if clickRegion then
                    for _, conn in ipairs(getconnections(clickRegion.MouseButton1Click)) do
                        conn:Fire()
                    end
                    break
                end
            end
        end
    end
    
    task.spawn(function()
        local adminPanel = pgui:WaitForChild("AdminPanel", 10)
        local mainFrame = adminPanel and adminPanel:WaitForChild("AdminPanel", 10)
        
        if mainFrame then
            -- BUCLE DE FUERZA DE 2 SEGUNDOS
            local startTime = tick()
            while tick() - startTime < 2 do
                mainFrame.Position = UDim2.new(10, 0, 10, 0)
                aplicarInvisibilidad(mainFrame)
                RunService.Heartbeat:Wait()
            end
            print("👻 Admin Panel bloqueado exitosamente fuera de cámara.")
        end
    end)
end

