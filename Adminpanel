-- Lógica de Guardado
local function saveSettings()
    if _G.SavedAdminPos and _G.SavedAdminPos.X then
        local data = {
            pos = {
                XScale = _G.SavedAdminPos.X.Scale,
                XOffset = _G.SavedAdminPos.X.Offset,
                YScale = _G.SavedAdminPos.Y.Scale,
                YOffset = _G.SavedAdminPos.Y.Offset
            },
            range = rangeValue
        }
        pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(data)) end)
    end
end

local function loadSettings()
    if isfile(FILE_NAME) then
        local success, content = pcall(readfile, FILE_NAME)
        if success then
            local s, data = pcall(function() return HttpService:JSONDecode(content) end)
            if s and data and data.pos then
                savedPos = UDim2.new(data.pos.XScale, data.pos.XOffset, data.pos.YScale, data.pos.YOffset)
                rangeValue = data.range or 50
                _G.SavedAdminPos = savedPos
            end
        end
    end
end

