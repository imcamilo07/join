local function updateMainSize()
    if listFrame.Visible then
        local contentHeight = layout.AbsoluteContentSize.Y
        -- Si no hay jugadores, se queda pequeño. Si hay, crece exacto.
        local targetHeight = (contentHeight > 0) and (contentHeight + 45) or 32
        main:TweenSize(UDim2.new(0, 170, 0, math.min(targetHeight, 350)), "Out", "Quart", 0.2, true)
    else
        main:TweenSize(UDim2.new(0, 170, 0, 32), "Out", "Quart", 0.2, true)
    end
end

