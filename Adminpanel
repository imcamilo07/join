local function addPlayer(p)
    if not p or p == lp then return end
    local card = Instance.new("Frame", listFrame)
    card.Size = UDim2.new(1, 0, 0, 32)
    card.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    card.Name = p.Name
    Instance.new("UICorner", card)

    local infoBtn = Instance.new("TextButton", card)
    infoBtn.Size = UDim2.new(0.8, 0, 1, 0)
    infoBtn.BackgroundTransparency = 1
    infoBtn.Text = ""

    local dName = Instance.new("TextLabel", infoBtn)
    dName.Size = UDim2.new(0, 0, 0, 15)
    dName.Position = UDim2.new(0, 5, 0, 3)
    dName.Text = p.DisplayName
    dName.Font = Enum.Font.GothamBold
    dName.TextSize = 9
    dName.TextColor3 = Color3.new(1,1,1)
    dName.BackgroundTransparency = 1
    dName.AutomaticSize = Enum.AutomaticSize.X

    local ownerLabel = Instance.new("TextLabel", infoBtn)
    ownerLabel.Text = "BASE OWNER"
    ownerLabel.TextColor3 = Color3.new(1, 0, 0)
    ownerLabel.Font = Enum.Font.GothamBold
    ownerLabel.TextSize = 7
    ownerLabel.Position = UDim2.new(0, 5, 0, 3)
    ownerLabel.Visible = false
    ownerLabel.BackgroundTransparency = 1

    local uName = Instance.new("TextLabel", infoBtn)
    uName.Size = UDim2.new(1, -10, 0, 10)
    uName.Position = UDim2.new(0, 5, 0, 16)
    uName.Font = Enum.Font.Gotham
    uName.TextSize = 7
    uName.TextColor3 = Color3.fromRGB(150, 150, 150)
    uName.BackgroundTransparency = 1

    local allBtn = Instance.new("TextButton", card)
    allBtn.Size = UDim2.new(0.2, 0, 1, 0)
    allBtn.Position = UDim2.new(0.8, 0, 0, 0)
    allBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    allBtn.BackgroundTransparency = 0.4
    allBtn.Text = "ALL"
    allBtn.TextColor3 = Color3.new(1,1,1)
    allBtn.Rotation = -90
    allBtn.Font = Enum.Font.GothamBold
    allBtn.TextSize = 8
    Instance.new("UICorner", allBtn)

    updateFunctions[card] = function()
        if not p.Parent then card:Destroy() updateFunctions[card] = nil return end
        local mineral = p:GetAttribute("StealingIndex")
        local stealing = p:GetAttribute("Stealing")
        uName.Text = "@" .. p.Name .. (mineral and (" | " .. mineral) or "")
        card.LayoutOrder = -(Prioridad[mineral] or 0)

        -- Lógica de Base (Detección de dueño de terreno)
        local enBase = false
        local lpChar = lp.Character
        if lpChar and lpChar:FindFirstChild("HumanoidRootPart") then
            for folder, owner in pairs(mapaDeDuenos) do
                if owner == p then
                    local plotFolder = Plots:FindFirstChild(folder)
                    if plotFolder then
                        local pv, ps = plotFolder:GetBoundingBox()
                        local localPos = pv:PointToObjectSpace(lpChar.HumanoidRootPart.Position)
                        if math.abs(localPos.X) <= ps.X/2 and math.abs(localPos.Z) <= ps.Z/2 then enBase = true break end
                    end
                end
            end
        end

        -- Aplicación de colores según estado
        if enBase then
            card.BackgroundColor3 = Color3.fromRGB(255, 255, 180) -- Amarillo Base
            dName.TextColor3 = Color3.new(0,0,0)
            uName.TextColor3 = Color3.fromRGB(50,50,50)
            ownerLabel.Visible = true
            ownerLabel.Position = UDim2.new(0, dName.TextBounds.X + 10, 0, 3)
        elseif stealing then
            card.BackgroundColor3 = Color3.fromRGB(85, 20, 20) -- Rojo Robo
            dName.TextColor3 = Color3.new(1,1,1)
            uName.TextColor3 = Color3.new(0.8,0.8,0.8)
            ownerLabel.Visible = false
        else
            card.BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- Normal
            dName.TextColor3 = Color3.new(1,1,1)
            uName.TextColor3 = Color3.new(0.6,0.6,0.6)
            ownerLabel.Visible = false
        end
    end

    infoBtn.MouseButton1Click:Connect(function()
        disparar(p.Name, EFECTOS_CLIC[indiceGlobal])
        indiceGlobal = (indiceGlobal % #EFECTOS_CLIC) + 1
    end)

    allBtn.MouseButton1Click:Connect(function()
        for _, ef in ipairs(EFECTOS_ALL) do disparar(p.Name, ef) end
    end)
end

local function refresh()
    updateFunctions = {}
    for _, c in ipairs(listFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    escanearPlots()
    for _, p in ipairs(Players:GetPlayers()) do addPlayer(p) end
    listFrame.CanvasSize = UDim2.new(0,0,0, layout.AbsoluteContentSize.Y)
    updateSize()
end

