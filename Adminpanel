-- Lógica de Guardado
local function saveSettings()
    local currentPos = _G.SavedAdminPos
    if currentPos and typeof(currentPos) == "UDim2" then
        local data = {
            pos = {XScale = currentPos.X.Scale, XOffset = currentPos.X.Offset, YScale = currentPos.Y.Scale, YOffset = currentPos.Y.Offset},
            range = rangeValue
        }
        pcall(function() writefile(FILE_NAME, HttpService:JSONEncode(data)) end)
    end
end

local function loadSettings()
    if isfile(FILE_NAME) then
        local success, content = pcall(readfile, FILE_NAME)
        if success then
            local s, data = pcall(function() return HttpService:JSONDecode(content) end)
            if s and data and data.pos then
                local loaded = UDim2.new(data.pos.XScale, data.pos.XOffset, data.pos.YScale, data.pos.YOffset)
                rangeValue = data.range or 50
                _G.SavedAdminPos = loaded
                return loaded
            end
        end
    end
    return defaultPos
end

