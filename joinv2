local function updateLogs(servidores, waitTime)
	local txt = ""
	for i = #servidores, 1, -1 do
		local srv = servidores[i]
		local estado = "✅"
		if srv.usado then estado = "⛔" end
		if srv.valor == 0 then estado = "🔻" end
		
		local displayName = srv.encontrado or "---"
		if #displayName > 18 then displayName = displayName:sub(1,16)..".." end
		
		txt = txt .. "["..srv.idx.."] " .. displayName .. " " .. estado .. "\n"
	end
	
	if waitTime then
		txt = txt .. "----------------\nCarga: " .. string.format("%.2f", waitTime) .. "s"
	end
	
	logsText.Text = txt
end

-- ================= CORE (OPTIMIZADO) =================

local function intentarUnirse(frame, firma, nombreDetectado)
	if joinLock then return end
	joinLock = true
	bigBtn.Visible = false

	local inner = frame:FindFirstChildWhichIsA("Frame")
	if not inner then joinLock = false return end
	local joinBtn = inner:FindFirstChildWhichIsA("TextButton")
	if not joinBtn then joinLock = false return end

	usados[firma] = true -- Firma más corta
	task.spawn(guardarUsados)
	
	for _,conn in ipairs(getconnections(joinBtn.MouseButton1Click)) do
		conn:Fire()
	end
	
	print("🚀 JOINING: " .. (nombreDetectado or "???"))

	-- (Optimización 5) Desbloqueo rápido: 1.2 segundos
	task.delay(1.2, function() 
		if joinLock then
			print("⚠️ Fallo/Lleno, desbloqueando...")
			joinLock = false
		end
	end)
end

-- (Optimización 1) Función para verificar si los últimos N Frames están listos
local function listoParaEscanear()
	local frames = scrolling:GetChildren()
	local count = 0
	-- Recorrer de atrás hacia adelante
	for i = #frames, 1, -1 do
		-- Solo contamos Frames visibles
		if frames[i]:IsA("Frame") and frames[i].Visible then
			count += 1
			if count >= MAX_SERVERS_A_ESCANEAR then
				return true
			end
		end
	end
	return false
end

local function escanearSmart()
	if joinLock then return end
	
	local rawChildren = scrolling:GetChildren()
    local framesValidos = {}
    
    -- Filtrar solo los Frames
    for _,obj in ipairs(rawChildren) do
        if obj:IsA("Frame") and obj.Visible then
            table.insert(framesValidos, obj)
        end
    end
    
	local candidatos = {}
	local logsData = {} 
	
    local total = #framesValidos
    local start = math.max(1, total - MAX_SERVERS_A_ESCANEAR + 1)
    
    for i = start, total do
        local obj = framesValidos[i]
        
        -- (Optimización 3) Búsqueda más rápida: No recursiva (el TextLabel está al mismo nivel que los botones)
        local lbl = obj:FindFirstChild("TextLabel", false) 
        
        if lbl and lbl.Text then
            local txt = lbl.Text
            local val, nombreEncontrado = parseValor(txt) 
            
            -- (Optimización 4) Firma más corta: Usamos el nombre detectado o el texto crudo.
            local firma = nombreEncontrado or txt 
            local isUsed = usados[firma] ~= nil
            
            table.insert(logsData, {
                idx = i,
                firma = firma, 
                valor = val, 
                encontrado = nombreEncontrado, 
                usado = isUsed
            })

            if val > 0 and not isUsed then
                table.insert(candidatos, {
                    frame = obj,
                    valor = val,
                    firma = firma,
                    nombre = nombreEncontrado
                })
            end
        end
    end
	
	updateLogs(logsData)

	if #candidatos > 0 then
		-- (Punto 6) Orden de prioridad: Mantener.
		table.sort(candidatos, function(a,b) return a.valor > b.valor end)
		local mejor = candidatos[1]
		
		bigBtn.Text = "JOIN: " .. mejor.nombre
		bigBtn.Visible = true
		
		task.defer(function()
			intentarUnirse(mejor.frame, mejor.firma, mejor.nombre)
		end)
		return true
	else
		bigBtn.Visible = false
		return false
	end
end

-- ================= EXTRAS (REFRESH, GUI, LOOP) =================

local function getRefreshBtn()
	if cachedRefreshBtn and cachedRefreshBtn.Parent then return cachedRefreshBtn end
	for _,obj in ipairs(mainFrame:GetDescendants()) do
		if obj:IsA("TextButton") and (obj.Text == "Refresh" or obj.ContentText == "Refresh") then
			cachedRefreshBtn = obj
			return obj
		end
	end
end

local function fireRefresh()
	local btn = getRefreshBtn()
	if btn then
		for _,conn in ipairs(getconnections(btn.MouseButton1Click)) do
			conn:Fire()
		end
	end
end

