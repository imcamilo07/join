local function updateLogs(servidores, waitTime)
	local txt = ""
	for i = 1, #servidores do
		local srv = servidores[i]
		local estado = srv.usado and "⛔" or (srv.valor == 0 and "🔻" or "✅")
		local displayName = srv.encontrado or "---"
		if #displayName > 18 then displayName = displayName:sub(1,16)..".." end
		txt = txt .. "["..srv.idx.."] " .. displayName .. " " .. estado .. "\n"
	end
	if waitTime then txt = txt .. "----------------\nCarga: " .. string.format("%.2f", waitTime) .. "s" end
	logsText.Text = txt
end

-- ================= CORE =================

local function intentarUnirse(frame, firma, nombreDetectado)
	if joinLock then return end
	joinLock = true; bigBtn.Visible = false
	local inner = frame:FindFirstChildWhichIsA("Frame")
	local joinBtn = inner and inner:FindFirstChildWhichIsA("TextButton")
	if not joinBtn then joinLock = false return end

	usados[firma] = true; task.spawn(guardarUsados)
	local s = Instance.new("Sound", game:GetService("SoundService")); s.SoundId = "rbxassetid://128387076668435"; s:Play(); game:GetService("Debris"):AddItem(s, 2)
	
	for i = 1, 200 do for _,c in ipairs(getconnections(joinBtn.MouseButton1Click)) do c:Fire() end end
	task.delay(1.2, function() joinLock = false end)
end

local function listoParaEscanear()
	local frames, count = scrolling:GetChildren(), 0
	for i = 1, #frames do if frames[i]:IsA("Frame") and frames[i].Visible then count += 1 end end
	return count >= MAX_SERVERS_A_ESCANEAR
end

local function escanearSmart()
	if joinLock then return end
	local framesValidos = {}
    for _,obj in ipairs(scrolling:GetChildren()) do if obj:IsA("Frame") and obj.Visible then table.insert(framesValidos, obj) end end
    
	local candidatos, logsData = {}, {}
    local limite = math.min(#framesValidos, MAX_SERVERS_A_ESCANEAR)
    
    for i = 1, limite do
        local obj = framesValidos[i]
        local lbl = obj:FindFirstChild("TextLabel", false) 
        if lbl and lbl.Text then
            local val, nombreEncontrado = parseValor(lbl.Text) 
            local isUsed = usados[lbl.Text] ~= nil
            table.insert(logsData, {idx = i, firma = lbl.Text, valor = val, encontrado = nombreEncontrado, usado = isUsed})
            if val > 0 and not isUsed then table.insert(candidatos, {frame = obj, valor = val, firma = lbl.Text, nombre = nombreEncontrado}) end
        end
    end
	updateLogs(logsData)
	if #candidatos > 0 then
		table.sort(candidatos, function(a,b) return a.valor > b.valor end)
		bigBtn.Text = "JOIN: " .. candidatos[1].nombre; bigBtn.Visible = true
		task.defer(function() intentarUnirse(candidatos[1].frame, candidatos[1].firma, candidatos[1].nombre) end)
		return true
	end
	bigBtn.Visible = false; return false
end

