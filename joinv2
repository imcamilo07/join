-- LOOP PRINCIPAL OPTIMIZADO
task.spawn(function()
	while true do
		if autoRefresh and not joinLock then
			
			fireRefresh()
			
			local start = tick()
			
			-- (Optimización 1) Esperar solo lo necesario, con límite de 0.35s
			while not listoParaEscanear() and (tick() - start) < MAX_WAIT_TIME do
				task.wait()
			end
			
			local waitTime = tick() - start
			
			-- (Optimización 2) Pausa mínima para renderizado
			task.wait(0.03) 
			
			escanearSmart()
			
			if logsFrame.Visible then
				logsText.Text = logsText.Text .. "\n(Wait: " .. string.format("%.2f", waitTime) .. "s)"
			end
		end
		
		task.wait(0.05) -- Pausa mínima entre ciclos de escaneo
	end
end)
