-- ==========================================
-- SCRIPT MODO CITA V28 (CICLO MANUAL V2 -> V1)
-- ==========================================

local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local HttpService = game:GetService("HttpService")

local TIEMPO_ESPERA = 30 
local FILE_POS = "posicion_boton_cita.json"

-- 1. FUNCIÓN V2 (SINCRO POR VISIBILIDAD)
local function setV2(debeEstarEncendido)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "Row_InvisOnStealv2(Admin)" then
            local checkImage = obj:FindFirstChild("Check", true)
            if checkImage and checkImage:IsA("ImageLabel") then
                local estaEncendido = checkImage.Visible
                if estaEncendido ~= debeEstarEncendido then
                    local clickArea = obj:FindFirstChild("ClickArea", true)
                    if clickArea then
                        local conexiones = getconnections(clickArea.MouseButton1Click)
                        for _, c in ipairs(conexiones) do c:Fire() end
                    end
                end
            end
            return
        end
    end
end

-- 2. FUNCIÓN OTROS (V1 Y STEAL)
-- Esta función ahora detecta si debe PRENDER o APAGAR basándose en el estado
local function setAtaque(debeEstarEncendido)
    local nombres = {"Invis", "Steal Target Priority"}
    for _, nombre in ipairs(nombres) do
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if (obj.Name == nombre or (obj:IsA("TextLabel") and obj.Text == nombre)) and obj:IsA("GuiObject") then
                local btn = obj:IsA("TextButton") and obj or obj:FindFirstAncestorWhichIsA("TextButton") or obj.Parent:FindFirstChildWhichIsA("TextButton")
                if btn then
                    -- Como estos no tienen un "Check" fácil de leer, confiamos en el ciclo del script
                    local conexiones = getconnections(btn.MouseButton1Click)
                    for _, c in ipairs(conexiones) do c:Fire() end
                end
            end
        end
    end
end

-- ================= INTERFAZ MOVIBLE =================
local sg = Instance.new("ScreenGui", PlayerGui); sg.Name = "CitaV28"; sg.ResetOnSpawn = false
local mainBtn = Instance.new("Frame", sg)
mainBtn.Size = UDim2.new(0, 85, 0, 35)
mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
Instance.new("UICorner", mainBtn)

local txt = Instance.new("TextLabel", mainBtn)
txt.Size = UDim2.new(1,0,1,0); txt.Text = "START"; txt.TextColor3 = Color3.new(1,1,1)
txt.BackgroundTransparency = 1; txt.TextScaled = true; txt.Font = "SourceSansBold"

local trigger = Instance.new("TextButton", mainBtn)
trigger.Size = UDim2.new(1,0,1,0); trigger.BackgroundTransparency = 1; trigger.Text = ""

-- --- Lógica de Arrastre ---
local dragging, dragStart, startPos
trigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
trigger.InputEnded:Connect(function()
    if dragging then dragging = false
        local pos = {X={S=mainBtn.Position.X.Scale, O=mainBtn.Position.X.Offset}, Y={S=mainBtn.Position.Y.Scale, O=mainBtn.Position.Y.Offset}}
        writefile(FILE_POS, HttpService:JSONEncode(pos))
    end
end)

if isfile(FILE_POS) then
    local p = HttpService:JSONDecode(readfile(FILE_POS))
    mainBtn.Position = UDim2.new(p.X.S, p.X.O, p.Y.S, p.Y.O)
else
    mainBtn.Position = UDim2.new(0.8, 0, 0.5, 0)
end

-- ================= LÓGICA DE CLIC MANUAL =================
local modo = 0 -- 0: Nada, 1: V2 Activo, 2: V1 Activo

trigger.MouseButton1Click:Connect(function()
    if modo == 0 or modo == 2 then
        -- PASAR A MODO V2
        if modo == 2 then setAtaque(false) task.wait(0.3) end -- Apaga V1 si estaba prendido
        setV2(true)
        
        modo = 1
        txt.Text = "V2 ON"
        mainBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200) -- Azul para V2
        
    elseif modo == 1 then
        -- PASAR A MODO V1 (ATAQUE)
        setV2(false) -- Apaga V2
        task.wait(0.5)
        setAtaque(true) -- Prende V1 y Steal
        
        modo = 2
        mainBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0) -- Rojo para Ataque
        
        -- Iniciar cuenta regresiva opcional (puedes quitar esto si prefieres que sea manual siempre)
        for i = TIEMPO_ESPERA, 0, -1 do
            txt.Text = "V1: " .. i
            task.wait(1)
            if modo ~= 2 then break end -- Si cambias de modo, se detiene
        end
        
        if modo == 2 then
            txt.Text = "READY"
            mainBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        end
    end
end)

-- ================= LIMPIEZA AUTOMÁTICA (5 SEGUNDOS) =================
task.spawn(function()
    task.wait(5)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "MiniContainer" then obj.Position = UDim2.new(5, 0, 0, 0) end
        if obj.Name == "StealContent" or obj.Name == "Steal Target" then
            local c = obj:IsA("Frame") and obj or obj:FindFirstAncestorWhichIsA("Frame")
            if c then c.Size = UDim2.new(0, 150, 0, 150); c.ClipsDescendants = true; c.BackgroundTransparency = 0.5 end
        end
    end
    if PlayerGui:FindFirstChild("MobileButtons") then PlayerGui.MobileButtons.Enabled = false end
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:FindFirstChild("Tab_Main", true) or gui:FindFirstChild("Section_STEALING", true) then
            local f = gui:FindFirstChildOfClass("Frame"); if f then f.Position = UDim2.new(5, 0, 0, 0) end
        end
    end
end)
