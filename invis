local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local HttpService = game:GetService("HttpService")

local TIEMPO_ESPERA = 30 
local FILE_POS = "screenshot_btn_v10.json"
local SIZE_TABLA = 150 

-- 1. FUNCIÓN DE ESPERA Y OCULTADO (Ahora espera al Hub)
local function prepararInterfaz()
    print("⏳ Esperando a que el Hub cargue...")
    
    -- Espera hasta encontrar el Hub (busca por una sección clave como Section_STEALING)
    local hubEncontrado = nil
    while not hubEncontrado do
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:FindFirstChild("Section_STEALING", true) or gui:FindFirstChild("Tab_Main", true) then
                hubEncontrado = gui
                break
            end
        end
        task.wait(0.5) -- Revisa cada medio segundo
    end

    task.wait(1) -- Espera un segundo extra para que se terminen de crear los botones internos
    print("✅ Hub detectado. Iniciando ocultado y ajustes...")

    -- Ocultar Hub principal
    local frame = hubEncontrado:FindFirstChildOfClass("Frame")
    if frame then frame.Position = UDim2.new(5, 0, 0, 0) end

    -- Ocultar MiniContainer
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "MiniContainer" then obj.Position = UDim2.new(5, 0, 0, 0) end
    end

    -- Ocultar MobileButtons
    local mb = PlayerGui:WaitForChild("MobileButtons", 5) -- Espera hasta 5 seg si no existe
    if mb then mb.Enabled = false end
    
    -- Tabla Steal Target Cuadrada 150x150
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "StealContent" or obj.Name == "Steal Target" then
            local container = obj:IsA("Frame") and obj or obj:FindFirstAncestorWhichIsA("Frame")
            if container then
                container.Size = UDim2.new(0, SIZE_TABLA, 0, SIZE_TABLA)
                container.ClipsDescendants = true
                container.BackgroundTransparency = 0.5
                print("📉 Tabla ajustada correctamente.")
            end
        end
    end
end

-- Ejecutamos la preparación en un hilo separado para que no bloquee el botón
task.spawn(prepararInterfaz)

-- 2. FUNCIÓN DE CLICK (Técnica exitosa)
local function presionar(nombre)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if nombre == "InvisV2" and obj.Name == "Row_InvisOnStealv2(Admin)" then
            local ca = obj:FindFirstChild("ClickArea", true)
            if ca then
                for _, c in ipairs(getconnections(ca.MouseButton1Click)) do c:Fire() end
                return true
            end
        elseif (obj.Name == nombre or (obj:IsA("TextLabel") and obj.Text == nombre)) and obj:IsA("GuiObject") then
            local btn = obj:IsA("TextButton") and obj or obj:FindFirstAncestorWhichIsA("TextButton") or obj.Parent:FindFirstChildWhichIsA("TextButton")
            if btn then
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
                return true
            end
        end
    end
    return false
end

-- ================= INTERFAZ DEL BOTÓN =================
local sg = Instance.new("ScreenGui", PlayerGui); sg.Name = "CitaV10"; sg.ResetOnSpawn = false
local mainBtn = Instance.new("Frame", sg)
mainBtn.Size = UDim2.new(0, 70, 0, 25) 
mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
Instance.new("UICorner", mainBtn)

local txt = Instance.new("TextLabel", mainBtn)
txt.Size = UDim2.new(1,0,1,0); txt.Text = "START"; txt.TextColor3 = Color3.new(1,1,1); txt.BackgroundTransparency = 1; txt.TextScaled = true; txt.Font = "SourceSansBold"

local trigger = Instance.new("TextButton", mainBtn)
trigger.Size = UDim2.new(1,0,1,0); trigger.BackgroundTransparency = 1; trigger.Text = ""

-- Lógica de arrastre
local dragging, dragStart, startPos
trigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
trigger.InputEnded:Connect(function(input) if dragging then dragging = false end end)

-- ================= LÓGICA DE INTERRUPTOR =================
local estado = "START"

trigger.MouseButton1Click:Connect(function()
    if estado == "START" then
        estado = "WAIT"
        presionar("InvisV2") 
        task.wait(0.2)
        presionar("Invis") 
        task.wait(0.2)
        presionar("Steal Target Priority") 
        mainBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        for i = TIEMPO_ESPERA, 0, -1 do
            txt.Text = tostring(i)
            task.wait(1)
        end
        txt.Text = "READY"
        mainBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        estado = "READY"
    elseif estado == "READY" then
        presionar("Invis") 
        task.wait(0.2)
        presionar("Steal Target Priority")
        task.wait(0.2)
        presionar("InvisV2") 
        txt.Text = "START"
        mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        estado = "START"
    end
end)

