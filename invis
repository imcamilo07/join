local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local TIEMPO_ESPERA = 30 

-- 1. FUNCIÓN V2 (DETECTA EL TRUE/FALSE QUE VISTE EN EL ESCÁNER)
local function setV2(debeEstarEncendido)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        -- Buscamos la fila del Invis V2
        if obj.Name == "Row_InvisOnStealv2(Admin)" then
            -- Buscamos el objeto "Check" que cambia de visible
            local checkImage = obj:FindFirstChild("Check", true)
            
            if checkImage and checkImage:IsA("ImageLabel") then
                local estaEncendido = checkImage.Visible -- True o False
                
                -- Si el estado actual es distinto al que queremos, hacemos click
                if estaEncendido ~= debeEstarEncendido then
                    local clickArea = obj:FindFirstChild("ClickArea", true)
                    if clickArea then
                        local conexiones = getconnections(clickArea.MouseButton1Click)
                        for _, c in ipairs(conexiones) do c:Fire() end
                        print("✅ V2 sincronizado a: " .. tostring(debeEstarEncendido))
                    end
                else
                    print("ℹ️ V2 ya estaba en " .. tostring(debeEstarEncendido) .. ", no se tocó.")
                end
            end
            return
        end
    end
    print("❌ No se encontró Row_InvisOnStealv2 para sincronizar.")
end

-- 2. FUNCIÓN PARA V1 Y STEAL (TU V11)
local function presionarOtros(nombre)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if (obj.Name == nombre or (obj:IsA("TextLabel") and obj.Text == nombre)) and obj:IsA("GuiObject") then
            local btn = obj:IsA("TextButton") and obj or obj:FindFirstAncestorWhichIsA("TextButton") or obj.Parent:FindFirstChildWhichIsA("TextButton")
            if btn then
                local conexiones = getconnections(btn.MouseButton1Click)
                for _, c in ipairs(conexiones) do c:Fire() end
                return true
            end
        end
    end
end

-- ================= INTERFAZ (TU V11) =================
local sg = Instance.new("ScreenGui", PlayerGui); sg.Name = "CitaV25"; sg.ResetOnSpawn = false
local mainBtn = Instance.new("Frame", sg)
mainBtn.Size = UDim2.new(0, 75, 0, 30); mainBtn.Position = UDim2.new(0.8, 0, 0.5, 0)
mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); Instance.new("UICorner", mainBtn)
local txt = Instance.new("TextLabel", mainBtn); txt.Size = UDim2.new(1,0,1,0); txt.Text = "START"; txt.TextColor3 = Color3.new(1,1,1); txt.BackgroundTransparency = 1; txt.TextScaled = true; txt.Font = "SourceSansBold"
local trigger = Instance.new("TextButton", mainBtn); trigger.Size = UDim2.new(1,0,1,0); trigger.BackgroundTransparency = 1; trigger.Text = ""

-- ================= LÓGICA DE INTERRUPTOR =================
local estado = "START"

trigger.MouseButton1Click:Connect(function()
    if estado == "START" then
        estado = "WAIT"
        
        -- 1. Sincronizar V2 (Apagar si está en true)
        setV2(false) 
        task.wait(0.5)
        
        -- 2. Activar V1 y Steal
        presionarOtros("Invis") 
        task.wait(0.5)
        presionarOtros("Steal Target Priority") 
        
        mainBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        for i = TIEMPO_ESPERA, 0, -1 do txt.Text = tostring(i); task.wait(1) end
        txt.Text = "READY"; mainBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0); estado = "READY"
        
    elseif estado == "READY" then
        -- 1. Desactivar V1 y Steal
        presionarOtros("Invis") 
        task.wait(0.5)
        presionarOtros("Steal Target Priority") 
        task.wait(0.5)
        
        -- 2. Sincronizar V2 (Encender si está en false)
        setV2(true) 
        
        txt.Text = "START"; mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50); estado = "START"
    end
end)

