-- ==========================================
-- SCRIPT MODO CITA V13 (OPTIMIZADO ANTI-LAG)
-- ==========================================

local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local HttpService = game:GetService("HttpService")

local TIEMPO_ESPERA = 30 
local SIZE_TABLA = 150 
local FILE_POS = "cita_btn_pos.json"

-- --- FUNCIONES DE ACCIÓN ---
local function switchV2()
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "Row_InvisOnStealv2(Admin)" then
            local ca = obj:FindFirstChild("ClickArea", true)
            if ca then
                for _, c in ipairs(getconnections(ca.MouseButton1Click)) do c:Fire() end
                return true
            end
        end
    end
    return false
end

local function presionarOtros(nombre)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if (obj.Name == nombre or (obj:IsA("TextLabel") and obj.Text == nombre)) and obj:IsA("GuiObject") then
            local btn = obj:IsA("TextButton") and obj or obj:FindFirstAncestorWhichIsA("TextButton") or obj.Parent:FindFirstChildWhichIsA("TextButton")
            if btn then
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
                return true
            end
        end
    end
    return false
end

-- --- SISTEMA DE OCULTADO OPTIMIZADO (SIN BUCLE PESADO) ---
local function limpiarObjeto(obj)
    -- Ocultar MiniContainer al instante
    if obj.Name == "MiniContainer" and obj:IsA("GuiObject") then
        obj.Position = UDim2.new(5, 0, 0, 0)
    end
    -- Ajustar tabla de Steal
    if obj.Name == "StealContent" or obj.Name == "Steal Target" then
        local container = obj:IsA("Frame") and obj or obj:FindFirstAncestorWhichIsA("Frame")
        if container then
            container.Size = UDim2.new(0, SIZE_TABLA, 0, SIZE_TABLA)
            container.ClipsDescendants = true
            container.BackgroundTransparency = 0.5
        end
    end
    -- Ocultar el Frame del Hub si aparece
    if obj:IsA("Frame") and (obj:FindFirstChild("Tab_Main", true) or obj:FindFirstChild("Section_STEALING", true)) then
        obj.Position = UDim2.new(5, 0, 0, 0)
    end
end

-- Limpiar lo que ya existe
for _, desc in ipairs(PlayerGui:GetDescendants()) do limpiarObjeto(desc) end

-- ESCUCHAR CUANDO ALGO NUEVO SE CREA (Esto no da lag)
PlayerGui.DescendantAdded:Connect(limpiarObjeto)

-- Desactivar MobileButtons una sola vez
if PlayerGui:FindFirstChild("MobileButtons") then PlayerGui.MobileButtons.Enabled = false end

-- ================= INTERFAZ DEL BOTÓN =================
local sg = Instance.new("ScreenGui", PlayerGui); sg.Name = "CitaV13"; sg.ResetOnSpawn = false
local mainBtn = Instance.new("Frame", sg)
mainBtn.Size = UDim2.new(0, 75, 0, 30) 
mainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
Instance.new("UICorner", mainBtn)

local txt = Instance.new("TextLabel", mainBtn)
txt.Size = UDim2.new(1,0,1,0); txt.Text = "START"; txt.TextColor3 = Color3.new(1,1,1); txt.BackgroundTransparency = 1; txt.TextScaled = true; txt.Font = "SourceSansBold"

local trigger = Instance.new("TextButton", mainBtn)
trigger.Size = UDim2.new(1,0,1,0); trigger.BackgroundTransparency = 1; trigger.Text = ""

-- Arrastre y guardado
local dragging, dragStart, startPos
trigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
trigger.InputEnded:Connect(function()
    if dragging then
        dragging = false
        writefile(FILE_POS, HttpService:JSONEncode({X={S=mainBtn.Position.X.Scale, O=mainBtn.Position.X.Offset}, Y={S=mainBtn.Position.Y.Scale, O=mainBtn.Position.Y.Offset}}))
    end
end)

if isfile(FILE_POS) then
    local p = HttpService:JSONDecode(readfile(FILE_POS))
    mainBtn.Position = UDim2.new(p.X.S, p.X.O, p.Y.S, p.Y.O)
else
    mainBtn.Position = UDim2.new(0.8, 0, 0.5, 0)
end

-- ================= LÓGICA DE INTERRUPTOR =================
local estado = "START"

trigger.MouseButton1Click:Connect(function()
    if estado == "START" then
        estado = "WAIT"
        switchV2() 
        task.wait(0.4)
        presionarOtros("Invis") 
        task.wait(0.4)
        presionarOtros("Steal Target Priority") 
        mainBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        for i = TIEMPO_ESPERA, 0, -1 do
            txt.Text = tostring(i)
            task.wait(1)
        end
        txt.Text = "READY"
        mainBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        estado = "READY"
    elseif estado == "READY" then
        presionarOtros("Invis") 
        task.wait(0.4)
        presionarOtros("Steal Target Priority") 
        task.wait(0.4)
        switchV2() 
        txt.Text = "START"
        mainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        estado = "START"
    end
end)
