local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local HttpService = game:GetService("HttpService")

local TIEMPO_ESPERA = 30 
local FILE_POS = "screenshot_btn_v9.json"
local SIZE_TABLA = 150 

-- 1. FUNCIÓN MAESTRA DE CLICK (Basada en tus pasos exitosos)
local function presionar(nombre)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        -- Si buscamos el V2 usamos la ruta de la fila
        if nombre == "InvisV2" and obj.Name == "Row_InvisOnStealv2(Admin)" then
            local ca = obj:FindFirstChild("ClickArea", true)
            if ca then
                for _, c in ipairs(getconnections(ca.MouseButton1Click)) do c:Fire() end
                return true
            end
        -- Para los demás botones normales o etiquetas
        elseif (obj.Name == nombre or (obj:IsA("TextLabel") and obj.Text == nombre)) and obj:IsA("GuiObject") then
            local btn = obj:IsA("TextButton") and obj or obj:FindFirstAncestorWhichIsA("TextButton") or obj.Parent:FindFirstChildWhichIsA("TextButton")
            if btn then
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
                return true
            end
        end
    end
    return false
end

-- 2. FUNCIÓN DE OCULTADO (Inmediata)
local function prepararTodo()
    -- Ocultar Hubs
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:FindFirstChild("Tab_Main", true) or gui:FindFirstChild("Section_STEALING", true) then
            local frame = gui:FindFirstChildOfClass("Frame")
            if frame then frame.Position = UDim2.new(5, 0, 0, 0) end
        end
    end
    -- Ocultar MiniContainer
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "MiniContainer" then obj.Position = UDim2.new(5, 0, 0, 0) end
    end
    -- Ocultar MobileButtons
    local mb = PlayerGui:FindFirstChild("MobileButtons")
    if mb then mb.Enabled = false end
    
    -- Tabla Steal Target Cuadrada 150x150
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "StealContent" or obj.Name == "Steal Target" then
            local container = obj:IsA("Frame") and obj or obj:FindFirstAncestorWhichIsA("Frame")
            if container then
                container.Size = UDim2.new(0, SIZE_TABLA, 0, SIZE_TABLA)
                container.ClipsDescendants = true
                container.BackgroundTransparency = 0.5
            end
        end
    end
end

prepararTodo()

-- ================= INTERFAZ DEL BOTÓN =================
local sg = Instance.new("ScreenGui", PlayerGui); sg.Name = "CitaV9"; sg.ResetOnSpawn = false
local mainBtn = Instance.new("Frame", sg)
mainBtn.Size = UDim2.new(0, 70, 0, 25) -- Pequeño, ancho y poco largo
mainBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
Instance.new("UICorner", mainBtn)

local txt = Instance.new("TextLabel", mainBtn)
txt.Size = UDim2.new(1,0,1,0); txt.Text = "START"; txt.TextColor3 = Color3.new(1,1,1); txt.BackgroundTransparency = 1; txt.TextScaled = true; txt.Font = "SourceSansBold"

local trigger = Instance.new("TextButton", mainBtn)
trigger.Size = UDim2.new(1,0,1,0); trigger.BackgroundTransparency = 1; trigger.Text = ""

-- Arrastre y guardado
local dragging, dragStart, startPos
trigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainBtn.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
trigger.InputEnded:Connect(function(input) if dragging then dragging = false end end)

-- ================= LÓGICA DE INTERRUPTOR =================
local estado = "START"

trigger.MouseButton1Click:Connect(function()
    if estado == "START" then
        estado = "WAIT"
        
        -- ACCIÓN: Pasar de V2 a V1
